<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conversations="using:Overworld.Apps.Crafter.Desktop.Conversations"
             xmlns:desktop="using:Overworld.Desktop"
             xmlns:imaging="using:Overworld.Apps.Crafter.Desktop.Imaging"
             xmlns:projects="using:Overworld.Apps.Crafter.Presentation.Projects"
             x:Class="Overworld.Apps.Crafter.Desktop.Projects.OverviewView"
             x:DataType="projects:OverviewViewModel">
  <UserControl.Styles>
    <StyleInclude Source="avares://crafter/Conversations/ProseStyles.axaml" />

    <Style Selector="TextBlock.section">
      <Setter Property="FontSize" Value="{StaticResource FontSizeFootnote}" />
      <Setter Property="LetterSpacing" Value="0.6" />
      <Setter Property="Foreground" Value="{DynamicResource SubtleBrush}" />
      <Setter Property="Margin" Value="0,0,0,8" />
    </Style>
    <Style Selector="Border.card">
      <Setter Property="Padding" Value="16,14" />
      <Setter Property="CornerRadius" Value="{StaticResource RadiusPanel}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
      <Setter Property="Background" Value="{DynamicResource RaisedBrush}" />
    </Style>
    <Style Selector="TextBox.summary">
      <Setter Property="AcceptsReturn" Value="True" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="MinHeight" Value="220" />
      <Setter Property="FontFamily" Value="{DynamicResource MonoFont}" />
      <Setter Property="FontSize" Value="{StaticResource FontSizeCallout}" />
      <Setter Property="VerticalContentAlignment" Value="Top" />
    </Style>
  </UserControl.Styles>

  <Panel>
    <ScrollViewer>
      <StackPanel MaxWidth="820" Margin="32,24" Spacing="24">
        <!-- Who the project is: its icon, its name, where it lives and on which branch. -->
        <DockPanel>
          <Border DockPanel.Dock="Left"
                  Width="52"
                  Height="52"
                  Margin="0,0,14,0"
                  CornerRadius="{StaticResource RadiusContainer}"
                  BorderThickness="1"
                  BorderBrush="{DynamicResource DividerBrush}"
                  Background="{DynamicResource SurfaceBrush}"
                  ClipToBounds="True">
            <Panel>
              <TextBlock Text="{Binding Project.Letter}"
                         IsVisible="{Binding !Project.HasIcon}"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         FontFamily="{DynamicResource MonoFont}"
                         FontSize="{StaticResource FontSizeTitle1}"
                         FontWeight="SemiBold" />
              <Image Source="{Binding Project.IconFile, Converter={x:Static imaging:FileImage.Instance}}"
                     IsVisible="{Binding Project.HasIcon}"
                     RenderOptions.BitmapInterpolationMode="None" />
            </Panel>
          </Border>
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <Button Classes="ghost" Content="Rename" ToolTip.Tip="F2" Command="{Binding StartRenameCommand}" IsVisible="{Binding !IsRenaming}" />
            <Button Name="ChooseIcon" Classes="ghost" Content="Icon" ToolTip.Tip="Pick a picture to be the project's icon" />
            <Button Classes="ghost" Content="No icon" Command="{Binding RemoveIconCommand}" IsVisible="{Binding Project.HasIcon}" />
            <Button Classes="ghost" Content="Remove project" Command="{Binding AskToRemoveCommand}" />
          </StackPanel>
          <StackPanel VerticalAlignment="Center" Spacing="2">
            <TextBlock Text="{Binding Project.Name}" IsVisible="{Binding !IsRenaming}" FontSize="{StaticResource FontSizeTitle1}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
            <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding IsRenaming}">
              <TextBox Name="NameBox" Text="{Binding NewName}" Width="260">
                <TextBox.KeyBindings>
                  <KeyBinding Gesture="Enter" Command="{Binding SaveNameCommand}" />
                  <KeyBinding Gesture="Escape" Command="{Binding CancelRenameCommand}" />
                </TextBox.KeyBindings>
              </TextBox>
              <Button Classes="primary" Content="Save" Command="{Binding SaveNameCommand}" />
              <Button Classes="ghost" Content="Cancel" Command="{Binding CancelRenameCommand}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="6">
              <TextBlock Text="{Binding Place}" FontFamily="{DynamicResource MonoFont}" FontSize="{StaticResource FontSizeCallout}" Foreground="{DynamicResource SubtleBrush}" />
              <TextBlock Text="{Binding Branch, StringFormat='· {0}'}"
                         IsVisible="{Binding Branch, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                         FontFamily="{DynamicResource MonoFont}"
                         FontSize="{StaticResource FontSizeCallout}"
                         Foreground="{DynamicResource AccentTextBrush}" />
            </StackPanel>
          </StackPanel>
        </DockPanel>

        <TextBlock Text="{Binding Problem}"
                   IsVisible="{Binding Problem, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource DangerBrush}" />

        <!-- The summary the project's agents read before every chat. -->
        <StackPanel>
          <TextBlock Classes="section" Text="SUMMARY · .crafter/summary.md" />
          <Border Classes="card">
            <Panel>
              <StackPanel Spacing="12" IsVisible="{Binding !IsEditing}">
                <conversations:ProseView Blocks="{Binding Blocks}" IsVisible="{Binding HasSummary}" />
                <TextBlock Text="No summary yet. Write what the project is, its stack, its layout and its commands; its agents read it before every chat."
                           IsVisible="{Binding !HasSummary}"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource SubtleBrush}" />
                <Button Classes="ghost" Content="Edit" Command="{Binding EditCommand}" HorizontalAlignment="Left" />
              </StackPanel>
              <StackPanel Spacing="10" IsVisible="{Binding IsEditing}">
                <TextBox Classes="summary" Text="{Binding Draft}" />
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <Button Classes="primary" Content="Save" Command="{Binding SaveSummaryCommand}" />
                  <Button Classes="ghost" Content="Cancel" Command="{Binding CancelEditCommand}" />
                </StackPanel>
              </StackPanel>
            </Panel>
          </Border>
        </StackPanel>

        <!-- The library's skills, and which of them the project gets. -->
        <StackPanel>
          <TextBlock Classes="section" Text="SKILLS" />
          <Border Classes="card">
            <Panel>
              <ItemsControl ItemsSource="{Binding Skills}" IsVisible="{Binding HasSkills}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Spacing="10" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="projects:SkillToggleViewModel">
                    <CheckBox IsChecked="{Binding Gets}" IsEnabled="{Binding CanChange}">
                      <StackPanel Spacing="2">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Description}" TextWrapping="Wrap" FontSize="{StaticResource FontSizeCallout}" Foreground="{DynamicResource SubtleBrush}" />
                      </StackPanel>
                    </CheckBox>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Text="The skills library has no skills yet; link one in Preferences."
                         IsVisible="{Binding !HasSkills}"
                         TextWrapping="Wrap"
                         Foreground="{DynamicResource SubtleBrush}" />
            </Panel>
          </Border>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>

    <desktop:Modal Title="Remove the project?" IsCompact="True" IsVisible="{Binding IsRemoving}" Name="Removing">
      <StackPanel Spacing="14">
        <TextBlock Text="{Binding Project.Name, StringFormat='{}{0} leaves Crafter. Its folder, its .crafter settings and its chats stay where they are.'}" TextWrapping="Wrap" />
        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
          <Button Classes="ghost" Content="Keep it" Command="{Binding KeepProjectCommand}" />
          <Button Classes="primary" Content="Remove" Command="{Binding RemoveCommand}" IsDefault="True" />
        </StackPanel>
      </StackPanel>
    </desktop:Modal>
  </Panel>
</UserControl>
