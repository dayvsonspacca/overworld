<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:aside="using:Overworld.Apps.Crafter.Desktop.Aside"
             xmlns:chats="using:Overworld.Apps.Crafter.Presentation.Chats"
             xmlns:conversations="using:Overworld.Apps.Crafter.Desktop.Conversations"
             xmlns:imaging="using:Overworld.Desktop.Imaging"
             xmlns:projects="using:Overworld.Apps.Crafter.Presentation.Projects"
             xmlns:pages="using:Overworld.Apps.Crafter.Desktop.Projects"
             xmlns:settings="using:Overworld.Apps.Crafter.Desktop.Preferences"
             xmlns:workbench="using:Overworld.Apps.Crafter.Presentation.Workbench"
             xmlns:desktop="using:Overworld.Desktop"
             xmlns:paintings="using:Overworld.Apps.Painting.Presentation.Lending"
             xmlns:paintingViews="using:Overworld.Apps.Painting.Views"
             xmlns:dye="using:Overworld.Apps.Dye.Presentation.Lending"
             xmlns:dyeViews="using:Overworld.Apps.Dye.Views"
             x:Class="Overworld.Apps.Crafter.Desktop.Workbench.WorkbenchView"
             x:DataType="workbench:WorkbenchViewModel">
  <!-- What other apps lend Crafter, each drawn by the view of the app that lends it. -->
  <UserControl.DataTemplates>
    <DataTemplate DataType="paintings:PaintingLoan">
      <paintingViews:PaintingLoanView />
    </DataTemplate>
    <DataTemplate DataType="dye:PaletteLoan">
      <dyeViews:PaletteLoanView />
    </DataTemplate>
    <DataTemplate DataType="dye:ThemeLoan">
      <dyeViews:ThemeLoanView />
    </DataTemplate>
  </UserControl.DataTemplates>

  <UserControl.Styles>
    <!-- A project on the rail: its icon or initial on a rounded tile, the current one marked at the edge. -->
    <Style Selector="Button.project">
      <Setter Property="Width" Value="34" />
      <Setter Property="Height" Value="34" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="{StaticResource RadiusContainer}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="ClipToBounds" Value="True" />
    </Style>
    <Style Selector="Button.project:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource BorderBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    </Style>
    <Style Selector="Button.project.current /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentLightBrush}" />
    </Style>

    <!-- A chat's state: working pulses in the accent, unread is lit, idle is only a ring. -->
    <Style Selector="Ellipse.state">
      <Setter Property="Width" Value="7" />
      <Setter Property="Height" Value="7" />
      <Setter Property="Stroke" Value="{DynamicResource FaintBrush}" />
      <Setter Property="StrokeThickness" Value="1" />
    </Style>
    <Style Selector="Ellipse.state.unread">
      <Setter Property="Fill" Value="{DynamicResource AccentLightBrush}" />
      <Setter Property="StrokeThickness" Value="0" />
    </Style>
    <Style Selector="Ellipse.state.working">
      <Setter Property="Fill" Value="{DynamicResource AccentBrush}" />
      <Setter Property="StrokeThickness" Value="0" />
      <Style.Animations>
        <Animation Duration="0:0:1.6" IterationCount="INFINITE">
          <KeyFrame Cue="0%"><Setter Property="Opacity" Value="1" /></KeyFrame>
          <KeyFrame Cue="50%"><Setter Property="Opacity" Value="0.35" /></KeyFrame>
          <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1" /></KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>

    <Style Selector="Button.rail-tool Path">
      <Setter Property="Width" Value="16" />
      <Setter Property="Height" Value="16" />
      <Setter Property="StrokeThickness" Value="1.1" />
      <Setter Property="Stroke" Value="{DynamicResource SubtleBrush}" />
    </Style>
    <Style Selector="Button.rail-tool">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.rail-tool:pointerover Path">
      <Setter Property="Stroke" Value="{DynamicResource TextBrush}" />
    </Style>

    <Style Selector="Button.project-name">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="8,4" />
      <Setter Property="CornerRadius" Value="{StaticResource RadiusSmall}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.project-name:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource HoverTintBrush}" />
    </Style>

    <!-- A narrow window keeps room for the conversation: the aside goes first, then the chats. -->
    <ContainerQuery Name="workbench" Query="max-width:1020">
      <Style Selector="Panel.aside-room">
        <Setter Property="IsVisible" Value="False" />
      </Style>
    </ContainerQuery>
    <ContainerQuery Name="workbench" Query="max-width:740">
      <Style Selector="Panel.list-room">
        <Setter Property="IsVisible" Value="False" />
      </Style>
    </ContainerQuery>

    <Style Selector="ListBox.chats ListBoxItem">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="6,1" />
    </Style>

    <!-- Dragging a chat left deletes it: the card slides off a strip that turns red once letting go would ask. -->
    <Style Selector="ListBox.chats Border.swipe-card">
      <Setter Property="Padding" Value="10,7" />
      <Setter Property="CornerRadius" Value="{StaticResource RadiusSmall}" />
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBox.chats Border.swipe-bin">
      <Setter Property="Opacity" Value="0" />
      <Setter Property="CornerRadius" Value="{StaticResource RadiusSmall}" />
      <Setter Property="ClipToBounds" Value="True" />
    </Style>
    <Style Selector="ListBox.chats Border.swipe-bin Border.tint">
      <Setter Property="Background" Value="{DynamicResource DangerBrush}" />
      <Setter Property="Opacity" Value="0.14" />
    </Style>
    <Style Selector="ListBox.chats Border.swipe-bin StackPanel">
      <Setter Property="TextElement.Foreground" Value="{DynamicResource DangerBrush}" />
    </Style>
    <Style Selector="ListBox.chats Border.swipe-bin Path">
      <Setter Property="Stroke" Value="{DynamicResource DangerBrush}" />
    </Style>
    <Style Selector="ListBox.chats ListBoxItem.swiping /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBox.chats ListBoxItem.swiping Border.swipe-card">
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="ListBox.chats ListBoxItem.armed Border.swipe-bin Border.tint">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="ListBox.chats ListBoxItem.armed Border.swipe-bin StackPanel">
      <Setter Property="TextElement.Foreground" Value="{DynamicResource BackgroundBrush}" />
    </Style>
    <Style Selector="ListBox.chats ListBoxItem.armed Border.swipe-bin Path">
      <Setter Property="Stroke" Value="{DynamicResource BackgroundBrush}" />
    </Style>

    <!-- Dragging a chat or a project up or down lifts it; the others make room. -->
    <Style Selector="ListBox.chats ListBoxItem.lifted /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBox.chats ListBoxItem.lifted Border.swipe-card">
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
      <Setter Property="BoxShadow" Value="0 8 22 0 #80000000" />
    </Style>
    <Style Selector="ListBox.chats.arranging ListBoxItem:not(.lifted), ItemsControl.rail.arranging ContentPresenter:not(.lifted)">
      <Setter Property="Transitions">
        <Transitions>
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.16" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="ItemsControl.rail ContentPresenter.lifted Button.project">
      <Setter Property="Background" Value="{DynamicResource BorderBrush}" />
      <Setter Property="RenderTransform" Value="scale(1.08)" />
    </Style>
    <Style Selector="ListBox.chats ListBoxItem.lifted, ListBox.chats ListBoxItem.swiping, ItemsControl.rail ContentPresenter.lifted">
      <Setter Property="Cursor" Value="SizeNorthSouth" />
    </Style>
  </UserControl.Styles>

  <Panel>
  <Grid ColumnDefinitions="Auto,Auto,*,Auto" Container.Name="workbench" Container.Sizing="Width">
    <!-- The rail: every project, one click away. -->
    <Border Width="56"
            Background="{DynamicResource BackgroundBrush}"
            BorderBrush="{DynamicResource DividerBrush}"
            BorderThickness="0,0,1,0">
      <DockPanel>
      <Button Name="PreferencesButton"
              DockPanel.Dock="Bottom"
              Classes="project rail-tool"
              Classes.current="{Binding ShowsPreferences}"
              Margin="0,8,0,10"
              HorizontalAlignment="Center"
              ToolTip.Tip="Preferences"
              Command="{Binding TogglePreferencesCommand}">
        <Path StrokeLineCap="Round" StrokeJoin="Round" Data="M12.96,8.61 L14.53,9.48 L13.67,11.57 L11.94,11.08 L11.08,11.94 L11.57,13.67 L9.48,14.53 L8.61,12.96 L7.39,12.96 L6.52,14.53 L4.43,13.67 L4.92,11.94 L4.06,11.08 L2.33,11.57 L1.47,9.48 L3.04,8.61 L3.04,7.39 L1.47,6.52 L2.33,4.43 L4.06,4.92 L4.92,4.06 L4.43,2.33 L6.52,1.47 L7.39,3.04 L8.61,3.04 L9.48,1.47 L11.57,2.33 L11.08,4.06 L11.94,4.92 L13.67,4.43 L14.53,6.52 L12.96,7.39 Z M10.2,8 A2.2,2.2 0 1 1 10.19,8 Z" />
      </Button>
      <ScrollViewer VerticalScrollBarVisibility="Hidden">
        <StackPanel Spacing="8" Margin="0,10">
        <ItemsControl Name="Rail" Classes="rail" ItemsSource="{Binding Projects}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Spacing="8" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="projects:ProjectViewModel">
              <Panel>
                <Border Width="4"
                        Height="20"
                        HorizontalAlignment="Left"
                        CornerRadius="0,3,3,0"
                        Background="{DynamicResource AccentLightBrush}"
                        IsVisible="{Binding IsCurrent}" />
                <Button Classes="project"
                        Classes.current="{Binding IsCurrent}"
                        HorizontalAlignment="Center"
                        ToolTip.Tip="{Binding Name}"
                        Command="{Binding $parent[ItemsControl].((workbench:WorkbenchViewModel)DataContext).OpenCommand}"
                        CommandParameter="{Binding}">
                  <Panel>
                    <TextBlock Text="{Binding Letter}"
                               IsVisible="{Binding !HasIcon}"
                               FontFamily="{DynamicResource MonoFont}"
                               FontSize="{StaticResource FontSizeBody}"
                               FontWeight="SemiBold" />
                    <Image Source="{Binding IconFile, Converter={x:Static imaging:FileImage.Instance}}"
                           IsVisible="{Binding HasIcon}"
                           Width="32"
                           Height="32"
                           RenderOptions.BitmapInterpolationMode="None" />
                  </Panel>
                </Button>
              </Panel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Button Classes="project rail-tool"
                HorizontalAlignment="Center"
                ToolTip.Tip="Add a project · Ctrl+K Ctrl+O"
                Command="{Binding AddProjectCommand}">
          <Path Data="M8,3 V13 M3,8 H13" />
        </Button>
        </StackPanel>
      </ScrollViewer>
      </DockPanel>
    </Border>

    <!-- The project's chats, searchable, newest first. -->
    <Panel Grid.Column="1" Classes="list-room">
    <Border Width="260"
            IsVisible="{Binding ShowsList}"
            Background="{DynamicResource RaisedBrush}"
            BorderBrush="{DynamicResource DividerBrush}"
            BorderThickness="0,0,1,0">
      <DockPanel DataContext="{Binding Project}" x:DataType="projects:ProjectViewModel" IsVisible="{Binding $self.DataContext, Converter={x:Static ObjectConverters.IsNotNull}}">
        <Border DockPanel.Dock="Top"
                Height="{StaticResource HeaderHeight}"
                Padding="6,0"
                BorderBrush="{DynamicResource DividerBrush}"
                BorderThickness="0,0,0,1">
          <DockPanel>
            <Button DockPanel.Dock="Right"
                    Classes="icon"
                    ToolTip.Tip="New chat · Ctrl+T"
                    Command="{Binding $parent[UserControl].((workbench:WorkbenchViewModel)DataContext).NewChatCommand}">
              <Path Data="M8,3 V13 M3,8 H13" />
            </Button>
            <Button Classes="project-name"
                    ToolTip.Tip="The project's page"
                    Command="{Binding $parent[UserControl].((workbench:WorkbenchViewModel)DataContext).OpenOverviewCommand}">
              <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
            </Button>
          </DockPanel>
        </Border>
        <TextBox Name="Search"
                 DockPanel.Dock="Top"
                 Margin="10"
                 PlaceholderText="Search chats"
                 Text="{Binding Query}" />
        <Panel>
          <ListBox Name="ChatList"
                   Classes="chats"
                   ItemsSource="{Binding Chats}"
                   SelectedItem="{Binding Chat}"
                   Background="Transparent">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="chats:ChatSummaryViewModel">
                <Panel>
                <Border Classes="swipe-bin">
                  <Panel>
                    <Border Classes="tint" />
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,16,0">
                      <Path Width="16" Height="16" StrokeThickness="1.3" StrokeLineCap="Round" StrokeJoin="Round"
                            Data="M3,4.5 H13 M6.5,4.5 V3 H9.5 V4.5 M4.5,4.5 L5.1,13 H10.9 L11.5,4.5 M7,7 V11 M9,7 V11" />
                      <TextBlock Text="Delete" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                  </Panel>
                </Border>
                <Border Classes="swipe-card">
                <StackPanel Spacing="2">
                  <DockPanel>
                    <Ellipse Classes="state"
                             Classes.working="{Binding IsWorking}"
                             Classes.unread="{Binding IsUnread}"
                             Margin="0,0,8,0"
                             VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                  </DockPanel>
                  <TextBlock Text="{Binding LastLine}"
                             IsVisible="{Binding LastLine, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                             Margin="15,0,0,0"
                             FontSize="{StaticResource FontSizeCallout}"
                             Foreground="{DynamicResource SubtleBrush}"
                             TextTrimming="CharacterEllipsis" />
                </StackPanel>
                </Border>
                </Panel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <TextBlock Text="No chats yet."
                     IsVisible="{Binding !HasChats}"
                     Margin="16,4"
                     Foreground="{DynamicResource SubtleBrush}" />
          <TextBlock Text="No chat has those words."
                     IsVisible="{Binding FindsNothing}"
                     Margin="16,4"
                     Foreground="{DynamicResource SubtleBrush}" />
        </Panel>
      </DockPanel>
    </Border>
    </Panel>

    <!-- The chat picked, as a timeline of what was asked and what the agent did. -->
    <Panel Grid.Column="2" Background="{DynamicResource BackgroundBrush}">
      <Panel IsVisible="{Binding Project.Chat, Converter={x:Static ObjectConverters.IsNotNull}, FallbackValue=False}">
        <conversations:ConversationDeck Name="Conversation" Conversation="{Binding Project.Chat.Conversation, FallbackValue={x:Null}}" />
      </Panel>
      <StackPanel IsVisible="{Binding Project.Chat, Converter={x:Static ObjectConverters.IsNull}, FallbackValue=True}"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Spacing="6">
        <TextBlock Text="No chat open." HorizontalAlignment="Center" Foreground="{DynamicResource TextSoftBrush}" />
        <TextBlock Text="Ctrl+T starts a new one." HorizontalAlignment="Center" FontSize="{StaticResource FontSizeCallout}" Foreground="{DynamicResource SubtleBrush}" />
      </StackPanel>
      <Panel IsVisible="{Binding Project.ShowsOverview, FallbackValue=False}" Background="{DynamicResource BackgroundBrush}">
        <pages:OverviewView DataContext="{Binding Project.Overview, FallbackValue={x:Null}}" />
      </Panel>
      <TextBlock Text="{Binding Project.Problem, FallbackValue={x:Null}}"
                 IsVisible="{Binding Project.Problem, Converter={x:Static StringConverters.IsNotNullOrEmpty}, FallbackValue=False}"
                 Margin="24"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Bottom"
                 TextWrapping="Wrap"
                 Foreground="{DynamicResource DangerBrush}" />
      <TextBlock Text="{Binding Problem}"
                 IsVisible="{Binding Problem, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"
                 TextWrapping="Wrap"
                 Foreground="{DynamicResource DangerBrush}" />
    </Panel>

    <!-- The project's todos, skills and axioms. -->
    <Panel Grid.Column="3" Classes="aside-room">
      <Panel Width="280" IsVisible="{Binding ShowsAside}">
        <aside:AsideView DataContext="{Binding Project.Aside, FallbackValue={x:Null}}" IsVisible="{Binding $self.DataContext, Converter={x:Static ObjectConverters.IsNotNull}}" />
      </Panel>
    </Panel>

    <!-- Preferences take the whole window but the rail. -->
    <Panel Grid.Column="1" Grid.ColumnSpan="3" IsVisible="{Binding ShowsPreferences}">
      <settings:PreferencesView DataContext="{Binding Preferences}" />
    </Panel>
  </Grid>

  <conversations:LoanStage DataContext="{Binding Project.Chat.Conversation, FallbackValue={x:Null}}" />

  <Panel IsVisible="{Binding Project.Chat.Conversation.Viewer.IsOpen, FallbackValue=False}">
    <conversations:PictureViewer DataContext="{Binding Project.Chat.Conversation.Viewer, FallbackValue={x:Null}}" />
  </Panel>

  <!-- Deleting a chat, asked once it is dragged far enough left. -->
  <desktop:Modal Name="RemovingChat"
                 Title="Delete the chat?"
                 IsCompact="True"
                 DataContext="{Binding Project}"
                 x:DataType="projects:ProjectViewModel"
                 IsVisible="{Binding IsRemovingChat, FallbackValue=False}">
    <StackPanel Spacing="14">
      <TextBlock Text="{Binding Removing.Title, StringFormat='&quot;{0}&quot; and everything said in it leave Crafter for good.', FallbackValue=''}" TextWrapping="Wrap" />
      <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
        <Button Classes="ghost" Content="Keep it" Command="{Binding KeepChatCommand}" />
        <Button Classes="primary" Content="Delete" Command="{Binding RemoveChatCommand}" IsDefault="True" />
      </StackPanel>
    </StackPanel>
  </desktop:Modal>

  <!-- Adding a project: the repositories under the projects folder, or any folder the system picker gives. -->
  <desktop:Modal Name="Adding"
                 Title="Add a project"
                 IsCompact="True"
                 DataContext="{Binding Adding}"
                 x:DataType="projects:AddProjectViewModel"
                 IsVisible="{Binding IsOpen}">
    <StackPanel Spacing="10">
      <TextBox Name="AddingSearch" Text="{Binding Query}" PlaceholderText="Search the repositories" />
      <TextBlock Text="{Binding Root, StringFormat='Git repositories under {0}'}" FontSize="{StaticResource FontSizeFootnote}" Foreground="{DynamicResource SubtleBrush}" />
      <Border Height="260"
              CornerRadius="{StaticResource RadiusControl}"
              BorderThickness="1"
              BorderBrush="{DynamicResource DividerBrush}"
              Background="{DynamicResource BackgroundBrush}">
        <Panel>
          <ListBox Name="AddingList" ItemsSource="{Binding Repositories}" SelectedItem="{Binding Selected}" Background="Transparent">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="projects:RepositoryChoice">
                <DockPanel>
                  <TextBlock DockPanel.Dock="Right"
                             Text="{Binding Place}"
                             Margin="12,0,0,0"
                             FontFamily="{DynamicResource MonoFont}"
                             FontSize="{StaticResource FontSizeFootnote}"
                             Foreground="{DynamicResource SubtleBrush}"
                             VerticalAlignment="Center" />
                  <TextBlock Text="{Binding Name}" FontFamily="{DynamicResource MonoFont}" FontSize="{StaticResource FontSizeCallout}" />
                </DockPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <TextBlock Text="Looking for repositories…" IsVisible="{Binding IsSearching}" Margin="12" Foreground="{DynamicResource SubtleBrush}" />
          <TextBlock Text="No repository here that is not open yet." IsVisible="{Binding FoundNone}" Margin="12" Foreground="{DynamicResource SubtleBrush}" />
        </Panel>
      </Border>
      <TextBlock Text="{Binding Problem}"
                 IsVisible="{Binding Problem, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                 TextWrapping="Wrap"
                 Foreground="{DynamicResource DangerBrush}" />
      <DockPanel>
        <Button Name="OtherFolder" DockPanel.Dock="Left" Classes="ghost" Content="Another folder…" />
        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
          <Button Classes="ghost" Content="Cancel" Command="{Binding CloseCommand}" />
          <Button Classes="primary" Content="Add" Command="{Binding AddCommand}" IsDefault="True" />
        </StackPanel>
      </DockPanel>
    </StackPanel>
  </desktop:Modal>
  </Panel>
</UserControl>
