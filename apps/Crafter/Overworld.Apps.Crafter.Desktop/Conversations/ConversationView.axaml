<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:composing="using:Overworld.Apps.Crafter.Presentation.Composing"
             xmlns:conversations="using:Overworld.Apps.Crafter.Presentation.Conversations"
             xmlns:imaging="using:Overworld.Apps.Crafter.Desktop.Imaging"
             xmlns:local="using:Overworld.Apps.Crafter.Desktop.Conversations"
             xmlns:text="using:Overworld.Desktop.Text"
             xmlns:framing="using:Overworld.Desktop.Framing"
             x:Class="Overworld.Apps.Crafter.Desktop.Conversations.ConversationView"
             x:DataType="conversations:ConversationViewModel">
  <UserControl.Resources>
    <!-- One step of a reply on the timeline: a node on the line, what happened beside it. -->
    <ControlTheme x:Key="{x:Type local:TimelineNode}" TargetType="local:TimelineNode">
      <Setter Property="Template">
        <ControlTemplate>
          <Grid ColumnDefinitions="28,*">
            <Rectangle Name="PART_Line" Width="1" HorizontalAlignment="Center" Fill="{DynamicResource DividerBrush}" Margin="0,0,11,0" />
            <Border Name="PART_Node"
                    Width="17"
                    Height="17"
                    CornerRadius="9"
                    Margin="0,2,11,0"
                    VerticalAlignment="Top"
                    HorizontalAlignment="Center"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource BorderBrush}"
                    Background="{DynamicResource BackgroundBrush}">
              <TextBlock Name="PART_Glyph"
                         Text="{TemplateBinding Glyph}"
                         FontFamily="{DynamicResource MonoFont}"
                         FontSize="9"
                         Foreground="{DynamicResource AccentTextBrush}"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center" />
            </Border>
            <ContentPresenter Grid.Column="1" Content="{TemplateBinding Content}" Margin="0,0,0,12" />
          </Grid>
        </ControlTemplate>
      </Setter>

      <Style Selector="^.speech /template/ Border#PART_Node">
        <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
      </Style>
      <Style Selector="^.speech /template/ TextBlock#PART_Glyph">
        <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
      </Style>
      <Style Selector="^.failed /template/ Border#PART_Node">
        <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
      </Style>
      <Style Selector="^.failed /template/ TextBlock#PART_Glyph">
        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
      </Style>
      <Style Selector="^.running /template/ Border#PART_Node">
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        <Style.Animations>
          <Animation Duration="0:0:1.6" IterationCount="INFINITE">
            <KeyFrame Cue="0%"><Setter Property="Opacity" Value="1" /></KeyFrame>
            <KeyFrame Cue="50%"><Setter Property="Opacity" Value="0.4" /></KeyFrame>
            <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1" /></KeyFrame>
          </Animation>
        </Style.Animations>
      </Style>
      <Style Selector="^.last /template/ Rectangle#PART_Line">
        <Setter Property="IsVisible" Value="False" />
      </Style>
    </ControlTheme>
  </UserControl.Resources>

  <UserControl.Styles>
    <StyleInclude Source="avares://crafter/Conversations/ProseStyles.axaml" />

    <!-- An act's row: a flat button that opens what the act gave back. -->
    <Style Selector="Button.act">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="4,2" />
      <Setter Property="Margin" Value="-4,0,0,0" />
      <Setter Property="CornerRadius" Value="{StaticResource RadiusSmall}" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Button.act:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource HoverTintBrush}" />
    </Style>
    <Style Selector="Button.act:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource ActiveTintBrush}" />
    </Style>
    <Style Selector="Button.act TextBlock">
      <Setter Property="FontFamily" Value="{DynamicResource MonoFont}" />
      <Setter Property="FontSize" Value="{StaticResource FontSizeCallout}" />
      <Setter Property="Foreground" Value="{DynamicResource TextSoftBrush}" />
    </Style>
    <Style Selector="Button.act TextBlock.added">
      <Setter Property="Foreground" Value="{DynamicResource AddedBrush}" />
    </Style>
    <Style Selector="Button.act TextBlock.removed, Button.act.failed TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
    </Style>
    <Style Selector="Button.act TextBlock.verdict">
      <Setter Property="Foreground" Value="{DynamicResource SubtleBrush}" />
    </Style>
    <Style Selector="SelectableTextBlock.output">
      <Setter Property="FontFamily" Value="{DynamicResource MonoFont}" />
      <Setter Property="FontSize" Value="{StaticResource FontSizeFootnote}" />
      <Setter Property="Foreground" Value="{DynamicResource TextSoftBrush}" />
      <Setter Property="LineHeight" Value="17" />
    </Style>
    <Style Selector="StackPanel.step.done TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource FaintBrush}" />
      <Setter Property="TextDecorations" Value="Strikethrough" />
    </Style>
    <Style Selector="StackPanel.step.done TextBlock.glyph">
      <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
      <Setter Property="TextDecorations" Value="{x:Null}" />
    </Style>
    <Style Selector="StackPanel.step.doing TextBlock">
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="StackPanel.step.doing TextBlock.glyph">
      <Setter Property="Foreground" Value="{DynamicResource AccentLightBrush}" />
    </Style>

    <!-- The message box: the text field melts into its frame, the frame lights when focused. -->
    <Style Selector="Border.composer">
      <Setter Property="Background" Value="{DynamicResource RaisedBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{StaticResource RadiusContainer}" />
      <Setter Property="Padding" Value="12,10" />
    </Style>
    <Style Selector="Border.composer:focus-within">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="TextBox.composer">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <!-- Even transparent and borderless, a rounded border leaves a speck in each corner. -->
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="MinHeight" Value="40" />
      <Setter Property="MaxHeight" Value="220" />
      <Setter Property="FontSize" Value="{StaticResource FontSizeContent}" />
      <Setter Property="AcceptsReturn" Value="True" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="VerticalContentAlignment" Value="Top" />
    </Style>
    <Style Selector="TextBox.composer /template/ Border#PART_BorderElement, TextBox.composer:pointerover /template/ Border#PART_BorderElement, TextBox.composer:focus /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>

    <!-- The suggestions over the message box: files after @, the project's skills after /. -->
    <Style Selector="Border.suggestion">
      <Setter Property="Padding" Value="10,6" />
      <Setter Property="CornerRadius" Value="{StaticResource RadiusSmall}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Border.suggestion:pointerover">
      <Setter Property="Background" Value="{DynamicResource HoverTintBrush}" />
    </Style>
    <Style Selector="Border.suggestion.selected">
      <Setter Property="Background" Value="{DynamicResource SelectedBrush}" />
    </Style>
    <Style Selector="TextBlock.hit">
      <Setter Property="Foreground" Value="{DynamicResource AccentLightBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- What goes along with the message: a picture's thumbnail or a file's name, removable. -->
    <Style Selector="Border.attachment">
      <Setter Property="Height" Value="32" />
      <Setter Property="Padding" Value="4,0,0,0" />
      <Setter Property="CornerRadius" Value="{StaticResource RadiusControl}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    </Style>
    <Style Selector="Border.attachment Button.icon">
      <Setter Property="Width" Value="24" />
      <Setter Property="Height" Value="24" />
    </Style>
    <Style Selector="Border.attachment Button.icon Path">
      <Setter Property="Width" Value="10" />
      <Setter Property="Height" Value="10" />
    </Style>
    <!-- A picture in the conversation: a thumbnail in a prompt or what the agent showed; either opens in the viewer. -->
    <Style Selector="Button.picture">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="{DynamicResource RaisedBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
      <Setter Property="CornerRadius" Value="{StaticResource RadiusControl}" />
      <Setter Property="ClipToBounds" Value="True" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.picture:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
      <Setter Property="Background" Value="{DynamicResource RaisedBrush}" />
    </Style>
    <Style Selector="Button.picture.shown">
      <Setter Property="CornerRadius" Value="{StaticResource RadiusPanel}" />
    </Style>
    <Style Selector="Image.thumb">
      <Setter Property="MaxHeight" Value="96" />
      <Setter Property="MaxWidth" Value="220" />
      <Setter Property="Stretch" Value="Uniform" />
    </Style>
    <Style Selector="Image.shown">
      <Setter Property="MaxHeight" Value="280" />
      <Setter Property="MaxWidth" Value="480" />
      <Setter Property="Stretch" Value="Uniform" />
      <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
    <Style Selector="TextBlock.caption">
      <Setter Property="Margin" Value="10,6" />
      <Setter Property="FontSize" Value="{StaticResource FontSizeCallout}" />
      <Setter Property="Foreground" Value="{DynamicResource SubtleBrush}" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="MaxWidth" Value="460" />
    </Style>
    <Style Selector="Border.drop">
      <Setter Property="Background" Value="{DynamicResource ScrimBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="CornerRadius" Value="{StaticResource RadiusContainer}" />
      <Setter Property="Margin" Value="12" />
    </Style>

    <!-- A request waits in an accent frame; once answered it quiets down. -->
    <Style Selector="Border.request">
      <Setter Property="Padding" Value="14,12" />
      <Setter Property="CornerRadius" Value="{StaticResource RadiusPanel}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
      <Setter Property="Background" Value="{DynamicResource RaisedBrush}" />
    </Style>
    <Style Selector="Border.request.open">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
      <Setter Property="Background" Value="{DynamicResource SelectedBrush}" />
    </Style>
    <Style Selector="TextBlock.added">
      <Setter Property="Foreground" Value="{DynamicResource AddedBrush}" />
    </Style>
    <Style Selector="TextBlock.removed">
      <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
    </Style>
    <Style Selector="TextBlock.answer">
      <Setter Property="FontSize" Value="{StaticResource FontSizeFootnote}" />
      <Setter Property="Foreground" Value="{DynamicResource SubtleBrush}" />
    </Style>
  </UserControl.Styles>

  <UserControl.DataTemplates>
    <DataTemplate DataType="conversations:PromptEntry">
      <Border HorizontalAlignment="Right"
              MaxWidth="560"
              Margin="60,8,0,16"
              Padding="12,8"
              CornerRadius="12,12,4,12"
              Background="{DynamicResource SurfaceBrush}">
        <StackPanel Spacing="6">
          <text:SelectableText Text="{Binding Text}" IsVisible="{Binding HasText}" TextWrapping="Wrap" FontSize="{StaticResource FontSizeContent}" LineHeight="22" />
          <ItemsControl ItemsSource="{Binding Files}" IsVisible="{Binding HasFiles}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="x:String">
                <TextBlock Text="{Binding StringFormat='@{0}'}"
                           FontFamily="{DynamicResource MonoFont}"
                           FontSize="{StaticResource FontSizeCallout}"
                           Foreground="{DynamicResource AccentLightBrush}"
                           TextTrimming="CharacterEllipsis" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding HasSkills}">
            <ItemsControl ItemsSource="{Binding Skills}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Horizontal" Spacing="10" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                  <TextBlock Text="{Binding StringFormat='/{0}'}"
                             FontFamily="{DynamicResource MonoFont}"
                             FontSize="{StaticResource FontSizeCallout}"
                             Foreground="{DynamicResource AccentTextBrush}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
          <ItemsControl ItemsSource="{Binding Pictures}" IsVisible="{Binding HasPictures}" HorizontalAlignment="Right">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel ItemSpacing="6" LineSpacing="6" HorizontalAlignment="Right" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="conversations:PictureView">
                <Button Classes="picture"
                        ToolTip.Tip="Open the picture"
                        Command="{Binding $parent[local:ConversationView].((conversations:ConversationViewModel)DataContext).OpenPictureCommand}"
                        CommandParameter="{Binding}">
                  <Image Classes="thumb" Source="{Binding Data, Converter={x:Static imaging:BytesImage.Instance}, ConverterParameter=192}" />
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
    </DataTemplate>

    <DataTemplate DataType="conversations:PictureEntry">
      <local:TimelineNode Glyph="◫">
        <StackPanel Spacing="6" HorizontalAlignment="Left">
          <Button Classes="picture shown"
                  ToolTip.Tip="Open the picture"
                  Command="{Binding $parent[local:ConversationView].((conversations:ConversationViewModel)DataContext).OpenPictureCommand}"
                  CommandParameter="{Binding Picture}">
            <StackPanel>
              <Image Classes="shown" Source="{Binding Picture.Data, Converter={x:Static imaging:BytesImage.Instance}, ConverterParameter=560}" />
              <TextBlock Classes="caption" Text="{Binding Caption}" IsVisible="{Binding HasCaption}" />
            </StackPanel>
          </Button>
        </StackPanel>
      </local:TimelineNode>
    </DataTemplate>

    <!-- What another app lent the chat, like a painting or a palette: alive while seen, expandable over the conversation. -->
    <DataTemplate DataType="conversations:LoanEntry">
      <local:TimelineNode Glyph="▧">
        <framing:ItemFrame Source="{Binding Loan.Source}"
                           Title="{Binding Loan.Title}"
                           IsSeen="{Binding Loan.IsLive}"
                           ExpandCommand="{Binding $parent[local:ConversationView].((conversations:ConversationViewModel)DataContext).ExpandLoanCommand}"
                           ExpandCommandParameter="{Binding}">
          <ContentControl Content="{Binding Loan}" />
        </framing:ItemFrame>
      </local:TimelineNode>
    </DataTemplate>

    <DataTemplate DataType="conversations:ThoughtEntry">
      <local:TimelineNode Glyph="…">
        <text:SelectableText Text="{Binding Text}"
                             TextWrapping="Wrap"
                             FontStyle="Italic"
                             LineHeight="20"
                             Foreground="{DynamicResource SubtleBrush}" />
      </local:TimelineNode>
    </DataTemplate>

    <DataTemplate DataType="conversations:SpeechEntry">
      <local:TimelineNode Glyph="✦" Classes="speech">
        <local:ProseView Blocks="{Binding Blocks}" />
      </local:TimelineNode>
    </DataTemplate>

    <DataTemplate DataType="conversations:ActEntry">
      <local:TimelineNode Glyph="{Binding Glyph}" Classes.failed="{Binding HasFailed}" Classes.running="{Binding IsRunning}">
        <StackPanel Spacing="4">
          <Button Classes="act" Classes.failed="{Binding HasFailed}" Command="{Binding ToggleCommand}" IsEnabled="{Binding HasOutput}">
            <DockPanel>
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6" Margin="12,0,0,0">
                <TextBlock Classes="added" Text="{Binding Added}" IsVisible="{Binding Added, Converter={x:Static ObjectConverters.IsNotNull}}" />
                <TextBlock Classes="removed" Text="{Binding Removed}" IsVisible="{Binding Removed, Converter={x:Static ObjectConverters.IsNotNull}}" />
                <TextBlock Classes="verdict" Text="{Binding Verdict}" IsVisible="{Binding Verdict, Converter={x:Static ObjectConverters.IsNotNull}}" />
              </StackPanel>
              <TextBlock Text="{Binding Subject}" TextTrimming="CharacterEllipsis" />
            </DockPanel>
          </Button>
          <Border IsVisible="{Binding ShowsOutput}"
                  Padding="10,8"
                  CornerRadius="{StaticResource RadiusControl}"
                  BorderThickness="1"
                  BorderBrush="{DynamicResource DividerBrush}"
                  Background="{DynamicResource RaisedBrush}">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
              <text:SelectableText Classes="output" Text="{Binding Shown}" />
            </ScrollViewer>
          </Border>
        </StackPanel>
      </local:TimelineNode>
    </DataTemplate>

    <DataTemplate DataType="conversations:PlanEntry">
      <local:TimelineNode Glyph="☰">
        <Border Padding="12,10"
                CornerRadius="{StaticResource RadiusPanel}"
                BorderThickness="1"
                BorderBrush="{DynamicResource DividerBrush}"
                Background="{DynamicResource RaisedBrush}">
          <StackPanel Spacing="4">
            <TextBlock Text="{Binding Progress, StringFormat='PLAN · {0}'}"
                       FontSize="{StaticResource FontSizeFootnote}"
                       LetterSpacing="0.6"
                       Foreground="{DynamicResource SubtleBrush}" />
            <ItemsControl ItemsSource="{Binding Lines}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="conversations:PlanLine">
                  <StackPanel Classes="step" Classes.done="{Binding IsDone}" Classes.doing="{Binding IsDoing}" Orientation="Horizontal" Spacing="8" Margin="0,1">
                    <TextBlock Classes="glyph" Text="{Binding Glyph}" Width="12" FontFamily="{DynamicResource MonoFont}" Foreground="{DynamicResource SubtleBrush}" />
                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
      </local:TimelineNode>
    </DataTemplate>

    <DataTemplate DataType="conversations:PermissionEntry">
      <local:TimelineNode Glyph="{Binding Glyph}">
        <Border Classes="request" Classes.open="{Binding IsOpen}">
          <StackPanel Spacing="8">
            <TextBlock Text="{Binding Asks}" FontWeight="SemiBold" />
            <text:SelectableText Text="{Binding Subject}"
                                 TextWrapping="Wrap"
                                 FontFamily="{DynamicResource MonoFont}"
                                 FontSize="{StaticResource FontSizeCallout}" />
            <TextBlock Text="{Binding Reason}"
                       IsVisible="{Binding HasReason}"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSoftBrush}" />
            <WrapPanel IsVisible="{Binding IsOpen}" ItemSpacing="6" LineSpacing="6">
              <Button Classes="primary" Content="Allow" Command="{Binding AllowOnceCommand}" />
              <Button Classes="ghost" IsVisible="{Binding CanRemember}" Command="{Binding AllowAlwaysCommand}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <TextBlock Text="Always allow" />
                  <TextBlock Text="{Binding Remembers}" FontFamily="{DynamicResource MonoFont}" Foreground="{DynamicResource SubtleBrush}" />
                </StackPanel>
              </Button>
              <Button Classes="ghost" Content="Deny" Command="{Binding DenyCommand}" />
            </WrapPanel>
            <TextBlock Classes="answer" Text="{Binding Answer}" IsVisible="{Binding !IsOpen}" />
          </StackPanel>
        </Border>
      </local:TimelineNode>
    </DataTemplate>

    <DataTemplate DataType="conversations:QuestionsEntry">
      <local:TimelineNode Glyph="?">
        <Border Classes="request" Classes.open="{Binding IsOpen}">
          <StackPanel Spacing="14">
            <ItemsControl ItemsSource="{Binding Asked}" IsEnabled="{Binding IsOpen}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Spacing="14" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="conversations:QuestionView">
                  <StackPanel Spacing="6">
                    <TextBlock Text="{Binding Header}"
                               FontSize="{StaticResource FontSizeFootnote}"
                               LetterSpacing="0.6"
                               Foreground="{DynamicResource SubtleBrush}" />
                    <TextBlock Text="{Binding Text}" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <ItemsControl ItemsSource="{Binding Options}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="conversations:OptionView">
                          <Panel Margin="0,2">
                            <CheckBox IsChecked="{Binding IsPicked}" IsVisible="{Binding $parent[ItemsControl].((conversations:QuestionView)DataContext).Several}">
                              <StackPanel>
                                <TextBlock Text="{Binding Label}" />
                                <TextBlock Text="{Binding Description}" IsVisible="{Binding HasDescription}" TextWrapping="Wrap" FontSize="{StaticResource FontSizeCallout}" Foreground="{DynamicResource SubtleBrush}" />
                              </StackPanel>
                            </CheckBox>
                            <RadioButton IsChecked="{Binding IsPicked}" GroupName="{Binding $parent[ItemsControl].((conversations:QuestionView)DataContext).Text}" IsVisible="{Binding !$parent[ItemsControl].((conversations:QuestionView)DataContext).Several}">
                              <StackPanel>
                                <TextBlock Text="{Binding Label}" />
                                <TextBlock Text="{Binding Description}" IsVisible="{Binding HasDescription}" TextWrapping="Wrap" FontSize="{StaticResource FontSizeCallout}" Foreground="{DynamicResource SubtleBrush}" />
                              </StackPanel>
                            </RadioButton>
                          </Panel>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBox Text="{Binding Written}" PlaceholderText="Or write your own answer" />
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding IsOpen}">
              <Button Classes="primary" Content="Answer" Command="{Binding SendAnswersCommand}" />
              <Button Classes="ghost" Content="Skip" Command="{Binding SkipCommand}" />
            </StackPanel>
            <TextBlock Classes="answer" Text="{Binding Answer}" IsVisible="{Binding !IsOpen}" />
          </StackPanel>
        </Border>
      </local:TimelineNode>
    </DataTemplate>

    <DataTemplate DataType="conversations:AxiomProposalEntry">
      <local:TimelineNode Glyph="§">
        <Border Classes="request" Classes.open="{Binding IsOpen}">
          <StackPanel Spacing="8">
            <TextBlock Text="A new axiom for the project" FontWeight="SemiBold" />
            <text:SelectableText Text="{Binding Axiom}" TextWrapping="Wrap" FontSize="{StaticResource FontSizeContent}" />
            <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding IsOpen}">
              <Button Classes="primary" Content="Approve" Command="{Binding ApproveCommand}" />
              <Button Classes="ghost" Content="Decline" Command="{Binding DeclineCommand}" />
            </StackPanel>
            <TextBlock Classes="answer" Text="{Binding Verdict}" IsVisible="{Binding !IsOpen}" />
          </StackPanel>
        </Border>
      </local:TimelineNode>
    </DataTemplate>

    <DataTemplate DataType="conversations:AxiomRemovalProposalEntry">
      <local:TimelineNode Glyph="§">
        <Border Classes="request" Classes.open="{Binding IsOpen}">
          <StackPanel Spacing="8">
            <TextBlock Text="Drop an axiom of the project" FontWeight="SemiBold" />
            <text:SelectableText Text="{Binding Axiom}" TextWrapping="Wrap" FontSize="{StaticResource FontSizeContent}" TextDecorations="Strikethrough" />
            <text:SelectableText Text="{Binding Why}" IsVisible="{Binding HasWhy}" TextWrapping="Wrap" Foreground="{DynamicResource SubtleBrush}" />
            <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding IsOpen}">
              <Button Classes="primary" Content="Drop it" Command="{Binding ApproveCommand}" />
              <Button Classes="ghost" Content="Keep it" Command="{Binding DeclineCommand}" />
            </StackPanel>
            <TextBlock Classes="answer" Text="{Binding Verdict}" IsVisible="{Binding !IsOpen}" />
          </StackPanel>
        </Border>
      </local:TimelineNode>
    </DataTemplate>

    <DataTemplate DataType="conversations:SummaryProposalEntry">
      <local:TimelineNode Glyph="¶">
        <Border Classes="request" Classes.open="{Binding IsOpen}">
          <StackPanel Spacing="10">
            <DockPanel>
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="4">
                <Button Classes="chip" Classes.chosen="{Binding ShowsPreview}" Content="Preview" Command="{Binding ShowPreviewCommand}" />
                <Button Classes="chip" Classes.chosen="{Binding ShowsChanges}" Content="Changes" Command="{Binding ShowChangesCommand}" />
              </StackPanel>
              <TextBlock Text="{Binding Asking}" FontWeight="SemiBold" VerticalAlignment="Center" />
            </DockPanel>
            <Border Classes="prose-preview" IsVisible="{Binding ShowsPreview}">
              <local:ProseView Blocks="{Binding Blocks}" />
            </Border>
            <Border Classes="prose-code" IsVisible="{Binding ShowsChanges}">
              <ItemsControl ItemsSource="{Binding Lines}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="conversations:SummaryLine">
                    <TextBlock Text="{Binding Marked}"
                               Classes.added="{Binding IsAdded}"
                               Classes.removed="{Binding IsRemoved}"
                               TextWrapping="Wrap"
                               FontFamily="{DynamicResource MonoFont}"
                               FontSize="{StaticResource FontSizeCallout}"
                               LineHeight="20" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Border>
            <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding IsOpen}">
              <Button Classes="primary" Content="Approve" Command="{Binding ApproveCommand}" />
              <Button Classes="ghost" Content="Decline" Command="{Binding DeclineCommand}" />
            </StackPanel>
            <TextBlock Classes="answer" Text="{Binding Verdict}" IsVisible="{Binding !IsOpen}" />
          </StackPanel>
        </Border>
      </local:TimelineNode>
    </DataTemplate>

    <DataTemplate DataType="conversations:NoticeEntry">
      <local:TimelineNode Glyph="↺">
        <TextBlock Text="{Binding Text}"
                   Margin="0,2,0,0"
                   TextWrapping="Wrap"
                   FontSize="{StaticResource FontSizeFootnote}"
                   Foreground="{DynamicResource SubtleBrush}" />
      </local:TimelineNode>
    </DataTemplate>

    <DataTemplate DataType="conversations:OutcomeEntry">
      <local:TimelineNode Glyph="■" Classes="last" Classes.failed="{Binding WentWrong}">
        <TextBlock Text="{Binding Text}"
                   Margin="0,2,0,8"
                   TextWrapping="Wrap"
                   FontSize="{StaticResource FontSizeFootnote}"
                   Foreground="{DynamicResource SubtleBrush}" />
      </local:TimelineNode>
    </DataTemplate>
  </UserControl.DataTemplates>

  <Panel DragDrop.AllowDrop="True">
  <DockPanel>
    <!-- The message box: what to ask next, and how the agent should work on it. -->
    <Border DockPanel.Dock="Bottom" Classes="composer" MaxWidth="760" Margin="24,4,24,14">
      <StackPanel Spacing="8">
        <ItemsControl ItemsSource="{Binding Attachments}" IsVisible="{Binding HasAttachments}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel ItemSpacing="6" LineSpacing="6" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="composing:AttachmentView">
              <Border Classes="attachment" ToolTip.Tip="{Binding Tip}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <Image Source="{Binding Data, Converter={x:Static imaging:BytesImage.Instance}}"
                         IsVisible="{Binding IsPicture}"
                         Width="24"
                         Height="24"
                         Stretch="UniformToFill" />
                  <TextBlock Text="{Binding Label}"
                             IsVisible="{Binding !IsPicture}"
                             VerticalAlignment="Center"
                             FontFamily="{DynamicResource MonoFont}"
                             FontSize="{StaticResource FontSizeCallout}"
                             MaxWidth="220"
                             TextTrimming="CharacterEllipsis" />
                  <Button Classes="icon"
                          ToolTip.Tip="Remove"
                          Command="{Binding $parent[local:ConversationView].((conversations:ConversationViewModel)DataContext).DetachCommand}"
                          CommandParameter="{Binding}">
                    <Path Data="M4,4 L12,12 M12,4 L4,12" />
                  </Button>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Text="{Binding Problem}"
                   IsVisible="{Binding Problem, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                   TextWrapping="Wrap"
                   FontSize="{StaticResource FontSizeFootnote}"
                   Foreground="{DynamicResource DangerBrush}" />
        <TextBox Name="Composer"
                 Classes="composer"
                 Text="{Binding Draft}"
                 PlaceholderText="{Binding Placeholder}" />
        <DockPanel>
          <Panel DockPanel.Dock="Right">
            <Button Classes="primary" Content="Send" Command="{Binding SendCommand}" IsVisible="{Binding !IsWorking}" ToolTip.Tip="Enter · Shift+Enter for a new line" />
            <Button Classes="ghost" Command="{Binding StopCommand}" IsVisible="{Binding IsWorking}" ToolTip.Tip="Stop the agent, and bring back what was sent if it has not answered yet · Esc twice clears the message">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Text="Stop" />
                <TextBlock Text="Esc" FontFamily="{DynamicResource MonoFont}" Foreground="{DynamicResource SubtleBrush}" />
              </StackPanel>
            </Button>
          </Panel>
          <WrapPanel ItemSpacing="6" LineSpacing="6" Margin="0,0,8,0" VerticalAlignment="Center">
            <Button Classes="chip" Content="{Binding ModeLabel}" Command="{Binding CycleModeCommand}" ToolTip.Tip="How the agent works: Auto, Edits or Plan" />
            <Button Name="ModelChip" Classes="chip" Content="{Binding ModelLabel}" ToolTip.Tip="The model the agent answers with" />
            <Button Classes="chip" Classes.chosen="{Binding IsMax}" Content="{Binding EffortLabel}" Command="{Binding ToggleEffortCommand}" ToolTip.Tip="How hard the agent thinks" />
            <TextBlock Text="{Binding QueuedLabel}"
                       IsVisible="{Binding HasQueued}"
                       Margin="6,0,0,0"
                       VerticalAlignment="Center"
                       FontSize="{StaticResource FontSizeFootnote}"
                       Foreground="{DynamicResource SubtleBrush}" />
          </WrapPanel>
        </DockPanel>
      </StackPanel>
    </Border>

    <Border DockPanel.Dock="Bottom"
            MaxWidth="760"
            Margin="24,0"
            Padding="4"
            IsVisible="{Binding Mentions.IsOpen}"
            CornerRadius="{StaticResource RadiusPanel}"
            BorderThickness="1"
            BorderBrush="{DynamicResource DividerBrush}"
            Background="{DynamicResource RaisedBrush}">
      <ItemsControl Name="Suggestions" ItemsSource="{Binding Mentions.Choices}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="composing:MentionViewModel">
            <Border Classes="suggestion" Classes.selected="{Binding IsSelected}" Tag="{Binding}">
              <DockPanel>
                <TextBlock DockPanel.Dock="Left"
                           Text="{Binding Glyph}"
                           Width="16"
                           FontFamily="{DynamicResource MonoFont}"
                           Foreground="{DynamicResource AccentTextBrush}" />
                <TextBlock DockPanel.Dock="Right"
                           Text="{Binding Folder}"
                           IsVisible="{Binding HasFolder}"
                           Margin="12,0,0,0"
                           FontFamily="{DynamicResource MonoFont}"
                           FontSize="{StaticResource FontSizeFootnote}"
                           Foreground="{DynamicResource SubtleBrush}"
                           TextTrimming="CharacterEllipsis" />
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <ItemsControl ItemsSource="{Binding Name}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="composing:NamePart">
                        <TextBlock Text="{Binding Text}" Classes.hit="{Binding IsHit}" FontFamily="{DynamicResource MonoFont}" FontSize="{StaticResource FontSizeCallout}" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <TextBlock Text="{Binding Description}"
                             IsVisible="{Binding IsSkill}"
                             FontSize="{StaticResource FontSizeCallout}"
                             Foreground="{DynamicResource SubtleBrush}"
                             TextTrimming="CharacterEllipsis" />
                </StackPanel>
              </DockPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </Border>

    <text:TextPage Name="Page">
      <ItemsControl Name="Entries" ItemsSource="{Binding Timeline.Shown}" MaxWidth="760" Margin="24,20,24,12" />
    </text:TextPage>
  </DockPanel>

  <Border Name="DropZone" Classes="drop" IsVisible="False" IsHitTestVisible="False">
    <TextBlock Text="Drop to attach" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="{StaticResource FontSizeTitle3}" />
  </Border>
  </Panel>
</UserControl>
