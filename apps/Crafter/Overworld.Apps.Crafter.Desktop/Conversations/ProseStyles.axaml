<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- What an agent says, drawn from its markdown and selected as one text. -->
    <Style Selector="SelectableTextBlock.prose">
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="FontSize" Value="{StaticResource FontSizeContent}" />
      <Setter Property="LineHeight" Value="22" />
    </Style>
    <Style Selector="SelectableTextBlock.prose.h1">
      <Setter Property="FontSize" Value="{StaticResource FontSizeTitle1}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="LineHeight" Value="30" />
    </Style>
    <Style Selector="SelectableTextBlock.prose.h2">
      <Setter Property="FontSize" Value="{StaticResource FontSizeTitle3}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="LineHeight" Value="24" />
    </Style>
    <Style Selector="SelectableTextBlock.prose.h3">
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="SelectableTextBlock.prose.marker">
      <Setter Property="MinWidth" Value="12" />
      <Setter Property="TextAlignment" Value="Right" />
      <Setter Property="TextWrapping" Value="NoWrap" />
      <Setter Property="Foreground" Value="{DynamicResource SubtleBrush}" />
    </Style>
    <Style Selector="SelectableTextBlock.prose.code">
      <Setter Property="FontFamily" Value="{DynamicResource MonoFont}" />
      <Setter Property="FontSize" Value="{StaticResource FontSizeCallout}" />
      <Setter Property="LineHeight" Value="20" />
      <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>
    <Style Selector="SelectableTextBlock.prose.td, SelectableTextBlock.prose.th">
      <Setter Property="MaxWidth" Value="360" />
    </Style>
    <Style Selector="SelectableTextBlock.prose.th">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource SubtleBrush}" />
    </Style>
    <Style Selector="Border.prose-quote">
      <Setter Property="Padding" Value="12,0,0,0" />
      <Setter Property="BorderThickness" Value="2,0,0,0" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    </Style>
    <Style Selector="Border.prose-quote SelectableTextBlock.prose">
      <Setter Property="Foreground" Value="{DynamicResource SubtleBrush}" />
    </Style>
    <Style Selector="Border.prose-code, Border.prose-table, Border.prose-preview">
      <Setter Property="CornerRadius" Value="{StaticResource RadiusPanel}" />
      <Setter Property="ClipToBounds" Value="True" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
      <Setter Property="Background" Value="{DynamicResource RaisedBrush}" />
    </Style>
    <Style Selector="Border.prose-preview">
      <Setter Property="Padding" Value="16,14" />
    </Style>
    <Style Selector="Border.prose-code">
      <Setter Property="Padding" Value="14,12" />
    </Style>
    <!-- A code block's copy button: in its top corner, over the code, shown while the pointer is on the block. -->
    <Style Selector="Button.prose-copy">
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="VerticalAlignment" Value="Top" />
      <Setter Property="Margin" Value="0,-6,-8,0" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
      <Setter Property="Background" Value="{DynamicResource RaisedBrush}" />
      <Setter Property="Opacity" Value="0" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.12" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Border.prose-code:pointerover Button.prose-copy, Button.prose-copy.copied, Button.prose-copy:focus-visible">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="Border.prose-table">
      <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
    <Style Selector="Border.prose-cell">
      <Setter Property="Padding" Value="12,8" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
      <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
    </Style>
    <Style Selector="Border.prose-cell.header">
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    </Style>
    <Style Selector="Border.prose-cell.last">
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Rectangle.prose-rule">
      <Setter Property="Height" Value="1" />
      <Setter Property="Fill" Value="{DynamicResource DividerBrush}" />
    </Style>
</Styles>
