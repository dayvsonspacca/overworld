<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conversations="using:Overworld.Apps.Crafter.Presentation.Conversations"
             x:Class="Overworld.Apps.Crafter.Desktop.Conversations.LoanStage"
             x:DataType="conversations:ConversationViewModel"
             IsVisible="{Binding Spread, Converter={x:Static ObjectConverters.IsNotNull}, FallbackValue=False}"
             Focusable="True">
  <!-- What another app lent the chat, spread over the whole conversation; its view exists only while it is open. -->
  <ContentControl Content="{Binding Spread, FallbackValue={x:Null}}">
    <ContentControl.ContentTemplate>
      <DataTemplate x:DataType="conversations:LoanEntry">
        <DockPanel Background="{DynamicResource BackgroundBrush}">
          <Border DockPanel.Dock="Top"
                  Height="{StaticResource HeaderHeight}"
                  Padding="16,0,8,0"
                  Background="{DynamicResource RaisedBrush}"
                  BorderBrush="{DynamicResource DividerBrush}"
                  BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10">
              <Border Padding="8,1" VerticalAlignment="Center" CornerRadius="{StaticResource RadiusPill}" Background="{DynamicResource SelectedBrush}">
                <TextBlock Text="{Binding Loan.Source}" FontSize="{StaticResource FontSizeFootnote}" Foreground="{DynamicResource AccentTextBrush}" />
              </Border>
              <TextBlock Grid.Column="1"
                         Text="{Binding Loan.Title}"
                         FontSize="{StaticResource FontSizeTitle3}"
                         FontWeight="SemiBold"
                         VerticalAlignment="Center"
                         TextTrimming="CharacterEllipsis" />
              <TextBlock Grid.Column="2"
                         Text="Esc closes"
                         VerticalAlignment="Center"
                         FontSize="{StaticResource FontSizeFootnote}"
                         Foreground="{DynamicResource FaintBrush}" />
              <Button Grid.Column="3"
                      Classes="icon"
                      ToolTip.Tip="Close · Esc"
                      Command="{Binding $parent[UserControl].((conversations:ConversationViewModel)DataContext).CloseSpreadCommand}">
                <Path Data="M2,2 L14,14 M14,2 L2,14" />
              </Button>
            </Grid>
          </Border>
          <ContentControl Content="{Binding Loan}" />
        </DockPanel>
      </DataTemplate>
    </ContentControl.ContentTemplate>
  </ContentControl>
</UserControl>
