<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conversations="using:Overworld.Apps.Crafter.Presentation.Conversations"
             xmlns:imaging="using:Overworld.Apps.Crafter.Desktop.Imaging"
             x:Class="Overworld.Apps.Crafter.Desktop.Conversations.PictureViewer"
             x:DataType="conversations:ViewerViewModel"
             IsVisible="{Binding IsOpen}"
             Focusable="True">
  <UserControl.Styles>
    <Style Selector="Button.round">
      <Setter Property="Width" Value="36" />
      <Setter Property="Height" Value="36" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="18" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
      <Setter Property="Background" Value="{DynamicResource RaisedBrush}" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.round Path">
      <Setter Property="Width" Value="12" />
      <Setter Property="Height" Value="12" />
      <Setter Property="Stretch" Value="Uniform" />
      <Setter Property="StrokeThickness" Value="1.4" />
      <Setter Property="Stroke" Value="{DynamicResource TextBrush}" />
    </Style>
    <Style Selector="Border.bar Button">
      <Setter Property="Height" Value="28" />
      <Setter Property="Padding" Value="12,0" />
      <Setter Property="FontSize" Value="{StaticResource FontSizeCallout}" />
    </Style>
  </UserControl.Styles>

  <Panel>
    <Border Name="Backdrop" Background="{DynamicResource BackgroundBrush}" Opacity="0.94" />
    <DockPanel>
      <Border DockPanel.Dock="Bottom"
              Classes="bar"
              Height="48"
              Padding="16,0"
              Background="{DynamicResource BackgroundBrush}"
              BorderBrush="{DynamicResource DividerBrush}"
              BorderThickness="0,1,0,0">
        <DockPanel>
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <Button Name="Copy" ToolTip.Tip="Copy the picture · Ctrl+C">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Text="Copy" />
                <TextBlock Text="Ctrl+C" FontFamily="{DynamicResource MonoFont}" Foreground="{DynamicResource SubtleBrush}" />
              </StackPanel>
            </Button>
            <Button Name="OpenOutside" Content="Open in the system viewer" />
            <TextBlock Text="Esc closes · ← → move"
                       Margin="6,0,0,0"
                       VerticalAlignment="Center"
                       FontSize="{StaticResource FontSizeFootnote}"
                       Foreground="{DynamicResource FaintBrush}" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
            <TextBlock Text="{Binding Position}"
                       FontFamily="{DynamicResource MonoFont}"
                       FontSize="{StaticResource FontSizeCallout}"
                       Foreground="{DynamicResource SubtleBrush}"
                       VerticalAlignment="Center" />
            <TextBlock Text="{Binding Current.Label, FallbackValue={x:Null}}"
                       Foreground="{DynamicResource TextSoftBrush}"
                       TextTrimming="CharacterEllipsis"
                       VerticalAlignment="Center" />
          </StackPanel>
        </DockPanel>
      </Border>

      <Panel>
        <Image Name="Stage"
               Margin="72,24"
               Stretch="Uniform"
               StretchDirection="DownOnly"
               Source="{Binding Current.Data, Converter={x:Static imaging:BytesImage.Instance}, FallbackValue={x:Null}}" />
        <Button Classes="round"
                Margin="12"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                ToolTip.Tip="Close · Esc"
                Command="{Binding CloseCommand}">
          <Path Data="M0,0 L12,12 M12,0 L0,12" />
        </Button>
        <Button Classes="round"
                Margin="16,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                IsVisible="{Binding HasOthers}"
                ToolTip.Tip="Previous · ←"
                Command="{Binding PreviousCommand}">
          <Path Data="M8,0 L2,6 L8,12" />
        </Button>
        <Button Classes="round"
                Margin="16,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                IsVisible="{Binding HasOthers}"
                ToolTip.Tip="Next · →"
                Command="{Binding NextCommand}">
          <Path Data="M4,0 L10,6 L4,12" />
        </Button>
      </Panel>
    </DockPanel>
  </Panel>
</UserControl>
