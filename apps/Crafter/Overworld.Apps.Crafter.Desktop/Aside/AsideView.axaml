<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:aside="using:Overworld.Apps.Crafter.Presentation.Aside"
             xmlns:library="using:Overworld.Apps.Crafter.Library"
             x:Class="Overworld.Apps.Crafter.Desktop.Aside.AsideView"
             x:DataType="aside:AsideViewModel">
  <UserControl.Styles>
    <!-- A row of the aside: its remove button shows only under the pointer. -->
    <Style Selector="Grid.row Button.remove">
      <Setter Property="Opacity" Value="0" />
    </Style>
    <Style Selector="Grid.row:pointerover Button.remove, Grid.row Button.remove:focus-visible">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="Grid.row Button.remove">
      <Setter Property="Width" Value="{StaticResource ControlSmall}" />
      <Setter Property="Height" Value="{StaticResource ControlSmall}" />
      <Setter Property="VerticalAlignment" Value="Top" />
    </Style>
    <Style Selector="Grid.row Button.remove Path">
      <Setter Property="Width" Value="12" />
      <Setter Property="Height" Value="12" />
    </Style>
    <Style Selector="SelectableTextBlock.done">
      <Setter Property="Foreground" Value="{DynamicResource FaintBrush}" />
      <Setter Property="TextDecorations" Value="Strikethrough" />
    </Style>
    <Style Selector="TextBlock.empty">
      <Setter Property="Foreground" Value="{DynamicResource SubtleBrush}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.problem">
      <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
      <Setter Property="FontSize" Value="{StaticResource FontSizeFootnote}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
  </UserControl.Styles>

  <Border Background="{DynamicResource RaisedBrush}"
          BorderBrush="{DynamicResource DividerBrush}"
          BorderThickness="1,0,0,0">
    <DockPanel>
      <Border DockPanel.Dock="Top"
              Padding="14,0"
              BorderBrush="{DynamicResource DividerBrush}"
              BorderThickness="0,0,0,1">
        <StackPanel Orientation="Horizontal" Spacing="16">
          <Button Classes="tab" Classes.chosen="{Binding ShowsTodos}" Command="{Binding ShowTodosCommand}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <TextBlock Text="Todos" />
              <TextBlock Classes="mono"
                         Text="{Binding Todos.Left}"
                         IsVisible="{Binding Todos.HasLeft}"
                         FontFamily="{DynamicResource MonoFont}"
                         FontSize="{StaticResource FontSizeFootnote}"
                         Foreground="{DynamicResource SubtleBrush}"
                         VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Classes="tab" Classes.chosen="{Binding ShowsSkills}" Command="{Binding ShowSkillsCommand}" Content="Skills" />
          <Button Classes="tab" Classes.chosen="{Binding ShowsAxioms}" Command="{Binding ShowAxiomsCommand}" Content="Axioms" />
        </StackPanel>
      </Border>

      <Panel>
        <!-- Todos: what is left to do in the project, the done ones after. -->
        <Panel IsVisible="{Binding ShowsTodos}">
        <DockPanel DataContext="{Binding Todos}" x:DataType="aside:TodosViewModel">
          <StackPanel DockPanel.Dock="Top" Margin="12" Spacing="6">
            <TextBox PlaceholderText="Something left to do" Text="{Binding NewTodo}">
              <TextBox.KeyBindings>
                <KeyBinding Gesture="Enter" Command="{Binding AddCommand}" />
              </TextBox.KeyBindings>
            </TextBox>
            <TextBlock Classes="problem" Text="{Binding Problem}" IsVisible="{Binding Problem, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          </StackPanel>
          <Panel>
            <ScrollViewer>
              <ItemsControl ItemsSource="{Binding Todos}" Margin="12,0,8,12">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Spacing="4" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="aside:TodoViewModel">
                    <Grid Classes="row" ColumnDefinitions="Auto,Auto,*,Auto">
                      <CheckBox IsChecked="{Binding Done}" VerticalAlignment="Top" MinWidth="0" Padding="0" Margin="0,0,6,0" />
                      <TextBlock Grid.Column="1"
                                 Text="{Binding Label}"
                                 Margin="0,6,6,0"
                                 FontFamily="{DynamicResource MonoFont}"
                                 FontSize="{StaticResource FontSizeFootnote}"
                                 Foreground="{DynamicResource SubtleBrush}" />
                      <SelectableTextBlock Grid.Column="2"
                                           Text="{Binding Text}"
                                           Margin="0,5,0,0"
                                           TextWrapping="Wrap"
                                           Classes.done="{Binding Done}" />
                      <Button Grid.Column="3" Classes="icon remove" Command="{Binding RemoveCommand}" ToolTip.Tip="Remove">
                        <Path Data="M4,4 L12,12 M12,4 L4,12" />
                      </Button>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
            <TextBlock Classes="empty" Text="Nothing left to do." IsVisible="{Binding !HasTodos}" Margin="14,0" />
          </Panel>
        </DockPanel>
        </Panel>

        <!-- Skills: what the project's agents can be called to do. -->
        <Panel IsVisible="{Binding ShowsSkills}">
        <Panel DataContext="{Binding Skills}" x:DataType="aside:SkillsViewModel">
          <ScrollViewer>
            <StackPanel Margin="14,12" Spacing="12">
              <TextBlock Classes="problem" Text="{Binding Problem}" IsVisible="{Binding Problem, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
              <ItemsControl ItemsSource="{Binding Skills}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Spacing="12" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="library:Skill">
                    <StackPanel Spacing="2">
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                      <TextBlock Text="{Binding Description}"
                                 TextWrapping="Wrap"
                                 FontSize="{StaticResource FontSizeCallout}"
                                 Foreground="{DynamicResource TextSoftBrush}" />
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Classes="empty" Text="The project has no skills yet." IsVisible="{Binding !HasSkills}" />
            </StackPanel>
          </ScrollViewer>
        </Panel>
        </Panel>

        <!-- Axioms: the rules every agent of the project follows. -->
        <Panel IsVisible="{Binding ShowsAxioms}">
        <DockPanel DataContext="{Binding Axioms}" x:DataType="aside:AxiomsViewModel">
          <StackPanel DockPanel.Dock="Top" Margin="12" Spacing="6">
            <TextBox PlaceholderText="A rule every agent follows" Text="{Binding NewAxiom}">
              <TextBox.KeyBindings>
                <KeyBinding Gesture="Enter" Command="{Binding AddCommand}" />
              </TextBox.KeyBindings>
            </TextBox>
            <TextBlock Classes="problem" Text="{Binding Problem}" IsVisible="{Binding Problem, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          </StackPanel>
          <Panel>
            <ScrollViewer>
              <ItemsControl Name="AxiomList" ItemsSource="{Binding Axioms}" Margin="14,0,8,12">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Spacing="8" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="x:String">
                    <Grid Classes="row" ColumnDefinitions="*,Auto">
                      <SelectableTextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,3,0,0" />
                      <Button Grid.Column="1"
                              Classes="icon remove"
                              ToolTip.Tip="Remove"
                              Command="{Binding #AxiomList.((aside:AxiomsViewModel)DataContext).RemoveCommand}"
                              CommandParameter="{Binding}">
                        <Path Data="M4,4 L12,12 M12,4 L4,12" />
                      </Button>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
            <TextBlock Classes="empty" Text="No axioms yet." IsVisible="{Binding !HasAxioms}" Margin="14,0" />
          </Panel>
        </DockPanel>
        </Panel>
      </Panel>
    </DockPanel>
  </Border>
</UserControl>
