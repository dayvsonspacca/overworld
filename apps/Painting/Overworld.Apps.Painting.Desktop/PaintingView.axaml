<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:presentation="using:Overworld.Apps.Painting.Presentation"
             x:Class="Overworld.Apps.Painting.Desktop.PaintingView"
             x:DataType="presentation:PaintingViewModel">
  <Panel>
    <NativeWebView x:Name="Canvas" IsVisible="{Binding Artwork, Converter={x:Static ObjectConverters.IsNotNull}}" />

    <TextBlock Text="Nothing painted yet."
               IsVisible="{Binding IsEmpty}"
               FontSize="{StaticResource FontSizeContent}"
               Foreground="{DynamicResource SubtleBrush}"
               HorizontalAlignment="Center"
               VerticalAlignment="Center" />

    <TextBlock Text="{Binding Problem}"
               IsVisible="{Binding Problem, Converter={x:Static ObjectConverters.IsNotNull}}"
               FontSize="{StaticResource FontSizeContent}"
               Foreground="{DynamicResource DangerBrush}"
               TextWrapping="Wrap"
               MaxWidth="480"
               HorizontalAlignment="Center"
               VerticalAlignment="Center" />
  </Panel>
</UserControl>
