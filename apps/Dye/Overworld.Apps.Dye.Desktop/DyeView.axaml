<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Overworld.Apps.Dye.Desktop"
             xmlns:presentation="using:Overworld.Apps.Dye.Presentation"
             x:Class="Overworld.Apps.Dye.Desktop.DyeView"
             x:DataType="presentation:DyeViewModel">
  <Panel>
    <Panel IsVisible="{Binding ShowsPalettes}">
      <local:PalettesView DataContext="{Binding Palettes}" />
    </Panel>
    <Panel IsVisible="{Binding ShowsThemes}">
      <local:ThemesView DataContext="{Binding Themes}" />
    </Panel>
    <Panel IsVisible="{Binding ShowsProfile}">
      <local:ProfileView DataContext="{Binding Profile}" />
    </Panel>
  </Panel>
</UserControl>
