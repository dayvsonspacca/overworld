<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:desktop="using:Overworld.Desktop"
             xmlns:palettes="using:Overworld.Apps.Dye.Palettes"
             xmlns:presentation="using:Overworld.Apps.Dye.Presentation"
             x:Class="Overworld.Apps.Dye.Desktop.PalettesView"
             x:DataType="presentation:PalettesViewModel">
  <Grid ColumnDefinitions="Auto,*">
    <desktop:Sidebar>
      <desktop:SidebarSection Title="Palettes" Count="{Binding Palettes.Count}" Fill="True">
        <Panel>
          <ListBox ItemsSource="{Binding Palettes}"
                   SelectedItem="{Binding Selected}"
                   Background="Transparent">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="palettes:Palette">
                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <TextBlock Text="No palettes yet."
                     IsVisible="{Binding !Palettes.Count}"
                     Margin="10,7"
                     Foreground="{DynamicResource ForegroundMutedBrush}" />
        </Panel>
      </desktop:SidebarSection>

      <desktop:SidebarSection Title="New palette">
        <StackPanel Spacing="14" IsEnabled="{Binding !New.IsSaving}">
          <desktop:TextField Label="Name"
                             Text="{Binding New.Name}"
                             Placeholder="Sea"
                             Hint="Must not be taken by another palette."
                             Error="{Binding New.NameError}" />
          <desktop:TextField Label="Colors"
                             Text="{Binding New.Colors}"
                             Placeholder="#003F5C, #58508D"
                             Hint="Hex colors in order, separated by commas."
                             Error="{Binding New.ColorsError}" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Classes="primary" Command="{Binding New.SaveCommand}" IsDefault="True">
              <Panel>
                <TextBlock Text="Save" IsVisible="{Binding !New.IsSaving}" />
                <TextBlock Text="Saving…" IsVisible="{Binding New.IsSaving}" />
              </Panel>
            </Button>
            <Button Classes="ghost" Content="Clear" Command="{Binding New.ClearCommand}" />
          </StackPanel>
          <TextBlock Text="{Binding New.Problem}"
                     IsVisible="{Binding New.Problem, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                     TextWrapping="Wrap"
                     FontSize="{StaticResource FontSizeFootnote}"
                     Foreground="{DynamicResource DangerBrush}" />
        </StackPanel>
      </desktop:SidebarSection>
    </desktop:Sidebar>

    <Panel Grid.Column="1">
      <ItemsControl ItemsSource="{Binding Swatches}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <UniformGrid Rows="1" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="presentation:Swatch">
            <Border Background="{Binding Fill, Converter={x:Static desktop:HexBrushConverter.Instance}}">
              <Viewbox StretchDirection="DownOnly"
                       VerticalAlignment="Bottom"
                       Margin="8,0,8,96">
                <TextBlock Text="{Binding Label}"
                           Foreground="{Binding Ink, Converter={x:Static desktop:HexBrushConverter.Instance}}"
                           FontSize="{StaticResource FontSizeLargeTitle}"
                           FontWeight="SemiBold" />
              </Viewbox>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <StackPanel IsVisible="{Binding !Palettes.Count}"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Spacing="8">
        <TextBlock Text="No palettes yet" FontSize="{StaticResource FontSizeTitle3}" HorizontalAlignment="Center" />
        <TextBlock Text="Save one on the left, or from a terminal:"
                   Foreground="{DynamicResource ForegroundMutedBrush}"
                   HorizontalAlignment="Center" />
        <TextBlock Classes="mono" Text="overworld:dye save --name Sea --colors &quot;#003F5C,#58508D&quot;" HorizontalAlignment="Center" />
      </StackPanel>

      <TextBlock Text="{Binding Problem}"
                 IsVisible="{Binding Problem, Converter={x:Static ObjectConverters.IsNotNull}}"
                 Foreground="{DynamicResource ForegroundMutedBrush}"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center" />
    </Panel>
  </Grid>
</UserControl>
