<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:desktop="using:Overworld.Desktop"
             xmlns:text="using:Overworld.Desktop.Text"
             xmlns:themes="using:Overworld.Apps.Dye.Presentation.Themes"
             x:Class="Overworld.Apps.Dye.Desktop.ThemesView"
             x:DataType="themes:ThemesViewModel">
  <Grid ColumnDefinitions="Auto,*">
    <desktop:Sidebar>
      <desktop:SidebarSection Title="Themes" Count="{Binding Themes.Count}" Fill="True">
        <Panel>
          <ListBox ItemsSource="{Binding Themes}" SelectedItem="{Binding Selected}" Background="Transparent">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="themes:ThemeLook">
                <Grid ColumnDefinitions="*,Auto,Auto">
                  <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="1"
                             Text="wearing"
                             IsVisible="{Binding Active}"
                             Margin="8,0,6,0"
                             VerticalAlignment="Center"
                             FontSize="{StaticResource FontSizeFootnote}"
                             FontWeight="SemiBold"
                             Foreground="{DynamicResource AccentTextBrush}" />
                  <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="3,0,0,0">
                    <Ellipse Width="10" Height="10" Margin="-3,0,0,0" Stroke="#26FFFFFF" StrokeThickness="1"
                             Fill="{Binding Background, Converter={x:Static desktop:HexBrushConverter.Instance}}" />
                    <Ellipse Width="10" Height="10" Margin="-3,0,0,0" Stroke="#26FFFFFF" StrokeThickness="1"
                             Fill="{Binding Accent, Converter={x:Static desktop:HexBrushConverter.Instance}}" />
                    <Ellipse Width="10" Height="10" Margin="-3,0,0,0" Stroke="#26FFFFFF" StrokeThickness="1"
                             Fill="{Binding Text, Converter={x:Static desktop:HexBrushConverter.Instance}}" />
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <TextBlock Text="No themes yet."
                     IsVisible="{Binding !Themes.Count}"
                     Margin="10,7"
                     Foreground="{DynamicResource SubtleBrush}" />
        </Panel>
      </desktop:SidebarSection>
    </desktop:Sidebar>

    <TextBlock Grid.Column="1"
               Text="{Binding Problem}"
               IsVisible="{Binding Selected, Converter={x:Static ObjectConverters.IsNull}}"
               TextWrapping="Wrap"
               MaxWidth="420"
               TextAlignment="Center"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"
               Foreground="{DynamicResource SubtleBrush}" />

    <text:TextPage Grid.Column="1" IsVisible="{Binding Selected, Converter={x:Static ObjectConverters.IsNotNull}}">
      <StackPanel Margin="28,22,28,28" Spacing="22">
        <Grid ColumnDefinitions="Auto,Auto,*,Auto">
          <text:SelectableText Text="{Binding Selected.Name, FallbackValue={x:Null}}"
                               FontSize="{StaticResource FontSizeTitle1}"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
          <Border Grid.Column="1"
                  IsVisible="{Binding Selected.Active, FallbackValue=False}"
                  Margin="12,0,0,0"
                  Height="24"
                  Padding="10,0"
                  CornerRadius="{StaticResource RadiusPill}"
                  VerticalAlignment="Center"
                  Background="{DynamicResource SelectedBrush}">
            <TextBlock Text="● Wearing now"
                       VerticalAlignment="Center"
                       FontSize="{StaticResource FontSizeCallout}"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource AccentTextBrush}" />
          </Border>
          <Button Grid.Column="3" Classes="primary" Command="{Binding ApplyCommand}">
            <Panel>
              <TextBlock Text="Apply" IsVisible="{Binding CanApply}" />
              <TextBlock Text="Applied" IsVisible="{Binding !CanApply}" />
            </Panel>
          </Button>
        </Grid>

        <TextBlock Text="{Binding Problem}"
                   IsVisible="{Binding Problem, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource DangerBrush}" />

        <StackPanel Spacing="8" DataContext="{Binding Selected}" x:DataType="themes:ThemeLook">
          <Border CornerRadius="{StaticResource RadiusContainer}"
                  BorderThickness="1"
                  BorderBrush="{DynamicResource DividerBrush}"
                  ClipToBounds="True">
            <Grid ColumnDefinitions="*,260" Height="230">
              <DockPanel Background="{Binding Background, Converter={x:Static desktop:HexBrushConverter.Instance}}">
                <Border DockPanel.Dock="Top"
                        Height="26"
                        BorderThickness="0,0,0,1"
                        Background="{Binding Raised, Converter={x:Static desktop:HexBrushConverter.Instance}}"
                        BorderBrush="{Binding Divider, Converter={x:Static desktop:HexBrushConverter.Instance}}">
                  <TextBlock Text="Crafter"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center"
                             FontSize="{StaticResource FontSizeCallout}"
                             FontWeight="SemiBold"
                             Foreground="{Binding Text, Converter={x:Static desktop:HexBrushConverter.Instance}}" />
                </Border>
                <Grid ColumnDefinitions="130,*">
                  <Border BorderThickness="0,0,1,0"
                          Padding="6,8"
                          Background="{Binding Raised, Converter={x:Static desktop:HexBrushConverter.Instance}}"
                          BorderBrush="{Binding Divider, Converter={x:Static desktop:HexBrushConverter.Instance}}">
                    <StackPanel Spacing="2">
                      <TextBlock Text="Projects" Margin="6,0,0,4" FontSize="10" FontWeight="SemiBold"
                                 Foreground="{Binding Subtle, Converter={x:Static desktop:HexBrushConverter.Instance}}" />
                      <Border CornerRadius="{StaticResource RadiusSmall}" Padding="6,4"
                              Background="{Binding Selected, Converter={x:Static desktop:HexBrushConverter.Instance}}">
                        <TextBlock Text="overworld" FontSize="{StaticResource FontSizeCallout}"
                                   Foreground="{Binding Text, Converter={x:Static desktop:HexBrushConverter.Instance}}" />
                      </Border>
                      <TextBlock Text="notes" Margin="6,4" FontSize="{StaticResource FontSizeCallout}"
                                 Foreground="{Binding TextSoft, Converter={x:Static desktop:HexBrushConverter.Instance}}" />
                      <TextBlock Text="site" Margin="6,4" FontSize="{StaticResource FontSizeCallout}"
                                 Foreground="{Binding TextSoft, Converter={x:Static desktop:HexBrushConverter.Instance}}" />
                    </StackPanel>
                  </Border>
                  <DockPanel Grid.Column="1" Margin="14,12">
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="6">
                      <Border Height="26" Padding="12,0" CornerRadius="{StaticResource RadiusControl}"
                              Background="{Binding Accent, Converter={x:Static desktop:HexBrushConverter.Instance}}">
                        <TextBlock Text="Save" VerticalAlignment="Center" FontSize="{StaticResource FontSizeCallout}" FontWeight="SemiBold"
                                   Foreground="{Binding OnAccent, Converter={x:Static desktop:HexBrushConverter.Instance}}" />
                      </Border>
                      <Border Height="26" Padding="12,0" CornerRadius="{StaticResource RadiusControl}" BorderThickness="1"
                              BorderBrush="{Binding Divider, Converter={x:Static desktop:HexBrushConverter.Instance}}">
                        <TextBlock Text="Cancel" VerticalAlignment="Center" FontSize="{StaticResource FontSizeCallout}" FontWeight="SemiBold"
                                   Foreground="{Binding Text, Converter={x:Static desktop:HexBrushConverter.Instance}}" />
                      </Border>
                    </StackPanel>
                    <StackPanel Spacing="8">
                      <TextBlock Text="Summary" FontSize="{StaticResource FontSizeTitle3}" FontWeight="SemiBold"
                                 Foreground="{Binding Text, Converter={x:Static desktop:HexBrushConverter.Instance}}" />
                      <TextBlock Text="What the project is, its stack and layout." FontSize="{StaticResource FontSizeCallout}"
                                 Foreground="{Binding Subtle, Converter={x:Static desktop:HexBrushConverter.Instance}}" />
                      <Border Height="26" Padding="8,0" CornerRadius="{StaticResource RadiusControl}" BorderThickness="1"
                              Background="{Binding Background, Converter={x:Static desktop:HexBrushConverter.Instance}}"
                              BorderBrush="{Binding Accent, Converter={x:Static desktop:HexBrushConverter.Instance}}">
                        <TextBlock Text="Search the project…" VerticalAlignment="Center" FontSize="{StaticResource FontSizeCallout}"
                                   Foreground="{Binding Text, Converter={x:Static desktop:HexBrushConverter.Instance}}" />
                      </Border>
                      <TextBlock Text="The folder was moved." FontSize="{StaticResource FontSizeCallout}"
                                 Foreground="{Binding Danger, Converter={x:Static desktop:HexBrushConverter.Instance}}" />
                    </StackPanel>
                  </DockPanel>
                </Grid>
              </DockPanel>

              <DockPanel Grid.Column="1" Background="{Binding Background, Converter={x:Static desktop:HexBrushConverter.Instance}}">
                <Border DockPanel.Dock="Bottom"
                        Height="34"
                        BorderThickness="0,1,0,0"
                        Background="{Binding Background, Converter={x:Static desktop:HexBrushConverter.Instance}}"
                        BorderBrush="{Binding Divider, Converter={x:Static desktop:HexBrushConverter.Instance}}">
                  <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Panel>
                      <Border Width="22" Height="22" CornerRadius="{StaticResource RadiusSmall}"
                              Background="{Binding Surface, Converter={x:Static desktop:HexBrushConverter.Instance}}" />
                      <Border Width="10" Height="2" CornerRadius="1" VerticalAlignment="Bottom" Margin="0,0,0,-4"
                              Background="{Binding Accent, Converter={x:Static desktop:HexBrushConverter.Instance}}" />
                    </Panel>
                    <Border Width="22" Height="22" CornerRadius="{StaticResource RadiusSmall}"
                            Background="{Binding Surface, Converter={x:Static desktop:HexBrushConverter.Instance}}" />
                    <Border Width="22" Height="22" CornerRadius="{StaticResource RadiusSmall}"
                            Background="{Binding Surface, Converter={x:Static desktop:HexBrushConverter.Instance}}" />
                    <Border Width="22" Height="22" CornerRadius="{StaticResource RadiusSmall}"
                            Background="{Binding Surface, Converter={x:Static desktop:HexBrushConverter.Instance}}" />
                  </StackPanel>
                </Border>
                <Border Margin="14"
                        Padding="10,8"
                        VerticalAlignment="Top"
                        BorderThickness="1"
                        CornerRadius="{StaticResource RadiusPanel}"
                        Background="{Binding Raised, Converter={x:Static desktop:HexBrushConverter.Instance}}"
                        BorderBrush="{Binding Divider, Converter={x:Static desktop:HexBrushConverter.Instance}}">
                  <StackPanel>
                    <TextBlock Text="Theme applied" FontSize="{StaticResource FontSizeCallout}"
                               Foreground="{Binding Text, Converter={x:Static desktop:HexBrushConverter.Instance}}" />
                    <TextBlock Text="{Binding Name, StringFormat='The shell and the apps wear {0}.'}"
                               TextWrapping="Wrap"
                               FontSize="{StaticResource FontSizeFootnote}"
                               Foreground="{Binding Subtle, Converter={x:Static desktop:HexBrushConverter.Instance}}" />
                  </StackPanel>
                </Border>
              </DockPanel>
              <Border Grid.Column="1" Width="1" HorizontalAlignment="Left" Background="{DynamicResource DividerBrush}" />
            </Grid>
          </Border>
          <TextBlock Text="An app and the shell in this theme's colors."
                     FontSize="{StaticResource FontSizeFootnote}"
                     Foreground="{DynamicResource SubtleBrush}" />
        </StackPanel>

        <ItemsControl ItemsSource="{Binding Groups}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Spacing="18" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="themes:RoleGroup">
              <StackPanel Spacing="10">
                <TextBlock Text="{Binding Title}"
                           FontSize="{StaticResource FontSizeFootnote}"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource SubtleBrush}" />
                <ItemsControl ItemsSource="{Binding Swatches}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <WrapPanel ItemWidth="160" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="themes:RoleSwatch">
                      <Border Margin="0,0,10,10"
                              BorderThickness="1"
                              CornerRadius="{StaticResource RadiusPanel}"
                              ClipToBounds="True"
                              BorderBrush="{DynamicResource DividerBrush}"
                              Background="{DynamicResource RaisedBrush}">
                        <StackPanel>
                          <Grid Height="46" ColumnDefinitions="*,*">
                            <Rectangle Fill="#000000" IsVisible="{Binding IsTint}" />
                            <Rectangle Grid.Column="1" Fill="#FFFFFF" IsVisible="{Binding IsTint}" />
                            <Rectangle Grid.ColumnSpan="2" Fill="{Binding Hex, Converter={x:Static desktop:HexBrushConverter.Instance}}" />
                          </Grid>
                          <StackPanel Margin="10,6,10,8">
                            <TextBlock Text="{Binding Role}" FontWeight="SemiBold" />
                            <text:SelectableText Text="{Binding Hex}"
                                                 FontFamily="{StaticResource MonoFont}"
                                                 FontSize="{StaticResource FontSizeFootnote}"
                                                 Foreground="{DynamicResource SubtleBrush}" />
                          </StackPanel>
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <StackPanel Spacing="4">
          <TextBlock Text="New themes come from a terminal or an agent:"
                     FontSize="{StaticResource FontSizeCallout}"
                     Foreground="{DynamicResource SubtleBrush}" />
          <text:SelectableText Text="{Binding Saving}"
                               TextWrapping="Wrap"
                               FontFamily="{StaticResource MonoFont}"
                               FontSize="{StaticResource FontSizeCallout}"
                               Foreground="{DynamicResource AccentLightBrush}" />
        </StackPanel>
      </StackPanel>
    </text:TextPage>
  </Grid>
</UserControl>
