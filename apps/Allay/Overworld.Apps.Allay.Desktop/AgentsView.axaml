<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:desktop="using:Overworld.Desktop"
             xmlns:agents="using:Overworld.Desktop.Agents"
             xmlns:presentation="using:Overworld.Apps.Allay.Presentation"
             xmlns:settings="using:Overworld.Allay.Settings"
             x:Class="Overworld.Apps.Allay.Desktop.AgentsView"
             x:DataType="presentation:AgentsViewModel">
  <UserControl.Styles>
    <Style Selector="Ellipse.dot">
      <Setter Property="Width" Value="7" />
      <Setter Property="Height" Value="7" />
      <Setter Property="Fill" Value="{DynamicResource AccentTextBrush}" />
    </Style>
    <Style Selector="Ellipse.dot.ready">
      <Setter Property="Fill" Value="{DynamicResource AddedBrush}" />
    </Style>
    <Style Selector="Ellipse.dot.blocked">
      <Setter Property="Fill" Value="{DynamicResource DangerBrush}" />
    </Style>
    <Style Selector="Border.pill">
      <Setter Property="Height" Value="22" />
      <Setter Property="Padding" Value="9,0" />
      <Setter Property="CornerRadius" Value="{StaticResource RadiusPill}" />
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    </Style>
    <Style Selector="Border.pill TextBlock">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="FontSize" Value="{StaticResource FontSizeCallout}" />
      <Setter Property="Foreground" Value="{DynamicResource TextSoftBrush}" />
    </Style>
    <Style Selector="Border.pill.ready TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource AddedBrush}" />
    </Style>
    <Style Selector="Border.pill.blocked TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
    </Style>
    <Style Selector="TextBlock.section">
      <Setter Property="FontSize" Value="{StaticResource FontSizeFootnote}" />
      <Setter Property="LetterSpacing" Value="0.6" />
      <Setter Property="Foreground" Value="{DynamicResource SubtleBrush}" />
    </Style>
    <Style Selector="TextBlock.hint">
      <Setter Property="FontSize" Value="{StaticResource FontSizeCallout}" />
      <Setter Property="Foreground" Value="{DynamicResource SubtleBrush}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.label">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{DynamicResource TextSoftBrush}" />
    </Style>
    <Style Selector="Border.remedy">
      <Setter Property="Padding" Value="12" />
      <Setter Property="CornerRadius" Value="{StaticResource RadiusControl}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
      <Setter Property="Background" Value="{DynamicResource RaisedBrush}" />
    </Style>
    <Style Selector="Border.command">
      <Setter Property="Padding" Value="10,7" />
      <Setter Property="CornerRadius" Value="{StaticResource RadiusControl}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
      <Setter Property="Background" Value="{DynamicResource BackgroundBrush}" />
    </Style>
    <Style Selector="ProgressBar.meter">
      <Setter Property="Height" Value="6" />
      <Setter Property="MinHeight" Value="6" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="Minimum" Value="0" />
      <Setter Property="Maximum" Value="100" />
      <Setter Property="CornerRadius" Value="{StaticResource RadiusPill}" />
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="ProgressBar.meter.close">
      <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
    </Style>
    <Style Selector="TextBlock.used">
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.used.close">
      <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
    </Style>
    <Style Selector="Border.card">
      <Setter Property="Padding" Value="16" />
      <Setter Property="CornerRadius" Value="{StaticResource RadiusPanel}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
      <Setter Property="Background" Value="{DynamicResource RaisedBrush}" />
    </Style>
  </UserControl.Styles>

  <DockPanel>
    <desktop:StatusBar DockPanel.Dock="Bottom">
      <desktop:StatusBar.Leading>
        <StackPanel Classes="item" Orientation="Horizontal">
          <TextBlock Text="{Binding Headcount}" />
        </StackPanel>
      </desktop:StatusBar.Leading>
      <desktop:StatusBar.Trailing>
        <StackPanel Classes="item" Orientation="Horizontal">
          <TextBlock Text="Every app that runs agents offers the hired ones" />
        </StackPanel>
      </desktop:StatusBar.Trailing>
    </desktop:StatusBar>

    <Grid ColumnDefinitions="Auto,*">
      <desktop:Sidebar>
        <desktop:SidebarSection Title="Agents" Count="{Binding Agents.Count}" Fill="True">
          <ListBox ItemsSource="{Binding Agents}" SelectedItem="{Binding Selected}" Background="Transparent">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="presentation:AgentViewModel">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                  <agents:AllayIcon Color="{Binding Color}" Width="28" Height="28" />
                  <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Standing}" FontSize="{StaticResource FontSizeFootnote}" Foreground="{DynamicResource SubtleBrush}" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                  <Ellipse Grid.Column="2" Classes="dot" Classes.ready="{Binding IsReady}" Classes.blocked="{Binding IsBlocked}" VerticalAlignment="Center" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </desktop:SidebarSection>
      </desktop:Sidebar>

      <Panel Grid.Column="1" Background="{DynamicResource BackgroundBrush}">
        <TextBlock Text="{Binding Problem}"
                   IsVisible="{Binding Problem, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource DangerBrush}"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center" />

        <ScrollViewer DataContext="{Binding Selected}" IsVisible="{Binding $self.DataContext, Converter={x:Static ObjectConverters.IsNotNull}}">
          <StackPanel x:DataType="presentation:AgentViewModel" MaxWidth="640" Margin="32,24" Spacing="22" HorizontalAlignment="Left">
            <!-- Who the agent is, and hiring it or letting it go. -->
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
              <agents:AllayIcon Color="{Binding Color}" Width="48" Height="48" />
              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="{Binding Name}" FontSize="{StaticResource FontSizeTitle1}" FontWeight="SemiBold" />
                <TextBlock Classes="hint" Text="{Binding Summary}" />
              </StackPanel>
              <Panel Grid.Column="2" VerticalAlignment="Center">
                <Button Classes="primary" Content="Hire" Command="{Binding HireCommand}" IsVisible="{Binding !IsHired}"
                        ToolTip.Tip="It must be installed and signed in first" ToolTip.ShowOnDisabled="True" />
                <Button Classes="ghost" Command="{Binding LetGoCommand}" IsVisible="{Binding IsHired}" ToolTip.Tip="Apps stop offering it">
                  <TextBlock Text="Let go" Foreground="{DynamicResource DangerBrush}" />
                </Button>
              </Panel>
            </Grid>

            <!-- Whether it can work on this machine. -->
            <StackPanel Orientation="Horizontal" Spacing="10">
              <Border Classes="pill" Classes.ready="{Binding IsReady}" Classes.blocked="{Binding IsBlocked}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <Ellipse Classes="dot" Classes.ready="{Binding IsReady}" Classes.blocked="{Binding IsBlocked}" VerticalAlignment="Center" />
                  <TextBlock Text="{Binding State}" />
                </StackPanel>
              </Border>
              <TextBlock Text="{Binding Detail}" IsVisible="{Binding IsReady}" VerticalAlignment="Center"
                         FontFamily="{DynamicResource MonoFont}" FontSize="{StaticResource FontSizeFootnote}" Foreground="{DynamicResource SubtleBrush}" />
            </StackPanel>

            <!-- What to do when it can't. -->
            <Border Classes="remedy" IsVisible="{Binding IsBlocked}">
              <StackPanel Spacing="10">
                <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" Foreground="{DynamicResource TextSoftBrush}" />
                <Border Classes="command" IsVisible="{Binding Remedy, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                  <SelectableTextBlock Text="{Binding Remedy}" FontFamily="{DynamicResource MonoFont}" FontSize="{StaticResource FontSizeCallout}" TextWrapping="Wrap" />
                </Border>
                <Button Classes="ghost" Content="Check again" Command="{Binding CheckCommand}" HorizontalAlignment="Left" />
              </StackPanel>
            </Border>

            <!-- How much of its limits it has used, and what it has spent. -->
            <Border Classes="card" IsVisible="{Binding ShowsUsage}">
              <StackPanel DataContext="{Binding Usage}" x:DataType="presentation:UsageViewModel" Spacing="14">
                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                  <TextBlock Classes="section" Text="USAGE" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="1" Classes="hint" Text="{Binding Checked}" IsVisible="{Binding !IsMeasuring}" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="1" Classes="hint" Text="Checking…" IsVisible="{Binding IsMeasuring}" VerticalAlignment="Center" />
                  <Button Grid.Column="2" Classes="icon" Command="{Binding MeasureCommand}" ToolTip.Tip="Check the usage again">
                    <Path Data="M12.5,8 A4.5,4.5 0 1 1 11,4.6 M11.5,2 V5 H8.5" />
                  </Button>
                </Grid>

                <ItemsControl ItemsSource="{Binding Limits}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel Spacing="14" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="presentation:LimitRow">
                      <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" RowSpacing="6">
                        <TextBlock Classes="label" Text="{Binding Name}" />
                        <TextBlock Grid.Column="1" Classes="used" Classes.close="{Binding Close}" Text="{Binding Used}" />
                        <ProgressBar Grid.Row="1" Grid.ColumnSpan="2" Classes="meter" Classes.close="{Binding Close}" Value="{Binding Fill}" />
                        <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Text="{Binding Resets}"
                                   IsVisible="{Binding Resets, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                   FontSize="{StaticResource FontSizeFootnote}" Foreground="{DynamicResource SubtleBrush}" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Grid DataContext="{Binding Spending}" x:DataType="presentation:SpendingRow"
                      IsVisible="{Binding $self.DataContext, Converter={x:Static ObjectConverters.IsNotNull}}"
                      ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="6">
                  <TextBlock Classes="label" Text="{Binding Name}" />
                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                    <TextBlock Classes="used" Text="{Binding Spent}" />
                    <TextBlock Text="{Binding Cap}" Foreground="{DynamicResource SubtleBrush}" />
                  </StackPanel>
                  <ProgressBar Grid.Row="1" Grid.ColumnSpan="2" Classes="meter" Value="{Binding Fill}"
                               IsVisible="{Binding Fill, Converter={x:Static ObjectConverters.IsNotNull}}" />
                </Grid>

                <TextBlock Classes="hint" Text="{Binding Problem}" IsVisible="{Binding Problem, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                <TextBlock Classes="hint" Text="It reports no limits and nothing spent." IsVisible="{Binding IsBare}" />
              </StackPanel>
            </Border>

            <!-- How it starts, once hired. -->
            <Border Classes="card" IsVisible="{Binding IsHired}">
              <StackPanel Spacing="14">
                <TextBlock Classes="section" Text="STARTS WITH" />
                <Grid ColumnDefinitions="90,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="12">
                  <TextBlock Classes="label" Text="Mode" />
                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                    <Button Classes="chip" Classes.chosen="{Binding IsAuto}" Content="Auto" Command="{Binding PickModeCommand}" CommandParameter="{x:Static settings:Mode.Auto}" />
                    <Button Classes="chip" Classes.chosen="{Binding IsEdits}" Content="Edits" Command="{Binding PickModeCommand}" CommandParameter="{x:Static settings:Mode.Edits}" />
                    <Button Classes="chip" Classes.chosen="{Binding IsPlan}" Content="Plan" Command="{Binding PickModeCommand}" CommandParameter="{x:Static settings:Mode.Plan}" />
                  </StackPanel>
                  <TextBlock Grid.Row="1" Grid.Column="1" Classes="hint" Text="{Binding ModeHint}" Margin="0,-6,0,0" />

                  <TextBlock Grid.Row="2" Classes="label" Text="Model" />
                  <ComboBox Grid.Row="2" Grid.Column="1" MinWidth="220" ItemsSource="{Binding Models}" SelectedItem="{Binding Model}">
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="settings:ModelOption">
                        <TextBlock Text="{Binding Label}" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>

                  <TextBlock Grid.Row="3" Classes="label" Text="Effort" />
                  <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Spacing="6">
                    <Button Classes="chip" Classes.chosen="{Binding !IsMax}" Content="Default" Command="{Binding PickEffortCommand}" CommandParameter="{x:Static settings:Effort.Default}" />
                    <Button Classes="chip" Classes.chosen="{Binding IsMax}" Content="Max" Command="{Binding PickEffortCommand}" CommandParameter="{x:Static settings:Effort.Max}" />
                  </StackPanel>
                </Grid>
                <TextBlock Classes="hint" Text="{Binding Name, StringFormat='Every app that runs {0} starts its chats like this; a chat can still change them for itself.'}" />
              </StackPanel>
            </Border>

            <TextBlock Classes="hint" Text="Hire it to choose the mode, model and effort it starts with." IsVisible="{Binding !IsHired}" />

            <TextBlock Text="{Binding Problem}"
                       IsVisible="{Binding Problem, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource DangerBrush}" />
          </StackPanel>
        </ScrollViewer>
      </Panel>
    </Grid>
  </DockPanel>
</UserControl>
