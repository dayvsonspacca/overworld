<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:desktop="using:Overworld.Desktop"
             xmlns:theming="using:Overworld.Desktop.Theming"
             x:Class="Overworld.Desktop.OverworldApplication"
             RequestedThemeVariant="{x:Static desktop:OverworldApplication.Variant}">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <theming:ThemeResources />
        <ResourceInclude Source="/Themes/Metrics.axaml" />
        <ResourceInclude Source="/Themes/TextField.axaml" />
        <ResourceInclude Source="/Themes/SidebarSection.axaml" />
        <ResourceInclude Source="/Themes/Sidebar.axaml" />
        <ResourceInclude Source="/Themes/TitleBar.axaml" />
        <ResourceInclude Source="/Themes/Modal.axaml" />
        <ResourceInclude Source="/Themes/StatusBar.axaml" />
        <ResourceInclude Source="/Themes/CommandPalette.axaml" />
      </ResourceDictionary.MergedDictionaries>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceInclude x:Key="{x:Static desktop:OverworldApplication.Variant}" Source="/Themes/Fluent.axaml" />
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="/Themes/Controls.axaml" />
  </Application.Styles>
</Application>
