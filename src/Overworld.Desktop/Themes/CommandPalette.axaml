<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:commands="using:Overworld.Desktop.Commands">
  <!-- The command palette over a window: type what to do, the list narrows, Enter runs it; each command shows its keys. -->
  <ControlTheme x:Key="{x:Type commands:CommandPalette}" TargetType="commands:CommandPalette">
    <Setter Property="IsVisible" Value="False" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel>
          <Border Name="PART_Scrim" Background="{DynamicResource ScrimBrush}" />
          <Border Width="620"
                  Margin="0,40,0,0"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Top"
                  Background="{DynamicResource RaisedBrush}"
                  BorderBrush="{DynamicResource DividerBrush}"
                  BorderThickness="1"
                  CornerRadius="{StaticResource RadiusContainer}"
                  ClipToBounds="True"
                  BoxShadow="0 24 64 0 #80000000">
            <DockPanel>
              <TextBox Name="PART_Input"
                       DockPanel.Dock="Top"
                       Classes="palette"
                       PlaceholderText="Type a command"
                       Text="{Binding Query, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" />
              <StackPanel DockPanel.Dock="Bottom" Classes="palette-hints" Orientation="Horizontal" Spacing="16">
                <TextBlock Text="↑ ↓ choose" />
                <TextBlock Text="Enter run" />
                <TextBlock Text="Esc close" />
              </StackPanel>
              <ListBox Name="PART_List"
                       MaxHeight="360"
                       Margin="6"
                       Background="Transparent"
                       Focusable="False"
                       ItemsSource="{TemplateBinding Items}"
                       SelectedIndex="{Binding SelectedIndex, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="commands:PaletteItem">
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12" Opacity="{Binding Command.Runs, Converter={x:Static commands:PaletteOpacity.Instance}}">
                      <commands:HighlightedText Words="{Binding Command.Title}"
                                                Hits="{Binding Hits}"
                                                HitBrush="{DynamicResource AccentLightBrush}"
                                                VerticalAlignment="Center"
                                                TextTrimming="CharacterEllipsis" />
                      <TextBlock Grid.Column="1"
                                 Text="{Binding Command.Group}"
                                 FontSize="{StaticResource FontSizeFootnote}"
                                 Foreground="{DynamicResource SubtleBrush}"
                                 VerticalAlignment="Center" />
                      <commands:KeyCaps Grid.Column="2" Shortcut="{Binding Command.Keys}" VerticalAlignment="Center" />
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </DockPanel>
          </Border>
        </Panel>
      </ControlTemplate>
    </Setter>

    <Style Selector="^:open">
      <Setter Property="IsVisible" Value="True" />
    </Style>
  </ControlTheme>
</ResourceDictionary>
