<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ResourceDictionary.MergedDictionaries>
    <ColorPaletteResources Accent="{StaticResource AccentColor}"
                           AltHigh="{StaticResource BackgroundColor}"
                           AltLow="{StaticResource BackgroundColor}"
                           AltMedium="{StaticResource BackgroundColor}"
                           AltMediumHigh="{StaticResource BackgroundColor}"
                           AltMediumLow="{StaticResource BackgroundColor}"
                           BaseHigh="{StaticResource TextColor}"
                           BaseLow="{StaticResource DividerColor}"
                           BaseMedium="{StaticResource SubtleColor}"
                           BaseMediumHigh="{StaticResource TextSoftColor}"
                           BaseMediumLow="{StaticResource FaintColor}"
                           ChromeAltLow="{StaticResource TextSoftColor}"
                           ChromeBlackHigh="#000000"
                           ChromeBlackLow="{StaticResource TextSoftColor}"
                           ChromeBlackMedium="{StaticResource BackgroundColor}"
                           ChromeBlackMediumLow="{StaticResource BackgroundColor}"
                           ChromeDisabledHigh="{StaticResource DividerColor}"
                           ChromeDisabledLow="{StaticResource SubtleColor}"
                           ChromeGray="{StaticResource FaintColor}"
                           ChromeHigh="{StaticResource FaintColor}"
                           ChromeLow="{StaticResource RaisedColor}"
                           ChromeMedium="{StaticResource SurfaceColor}"
                           ChromeMediumLow="{StaticResource RaisedColor}"
                           ChromeWhite="{StaticResource TextColor}"
                           ListLow="{StaticResource RaisedColor}"
                           ListMedium="{StaticResource DividerColor}"
                           RegionColor="{StaticResource BackgroundColor}" />
  </ResourceDictionary.MergedDictionaries>

  <SolidColorBrush x:Key="TextSelectionBrush" Color="{StaticResource AccentColor}" Opacity="0.35" />

  <SolidColorBrush x:Key="MenuFlyoutPresenterBackground" Color="{StaticResource RaisedColor}" />
  <SolidColorBrush x:Key="MenuFlyoutPresenterBorderBrush" Color="{StaticResource DividerColor}" />
  <SolidColorBrush x:Key="MenuFlyoutItemBackgroundPointerOver" Color="{StaticResource DividerColor}" />
  <SolidColorBrush x:Key="MenuFlyoutItemBackgroundPressed" Color="{StaticResource DividerColor}" />
  <SolidColorBrush x:Key="MenuFlyoutItemForegroundPointerOver" Color="{StaticResource TextColor}" />
  <SolidColorBrush x:Key="MenuFlyoutItemForegroundPressed" Color="{StaticResource TextColor}" />
  <SolidColorBrush x:Key="MenuFlyoutSeparatorBackground" Color="{StaticResource DividerColor}" />
  <SolidColorBrush x:Key="TextControlForeground" Color="{StaticResource TextColor}" />
  <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="{StaticResource TextColor}" />
  <SolidColorBrush x:Key="TextControlForegroundFocused" Color="{StaticResource TextColor}" />
  <SolidColorBrush x:Key="TextControlForegroundDisabled" Color="{StaticResource TextColor}" />
  <SolidColorBrush x:Key="TextControlBackground" Color="{StaticResource BackgroundColor}" />
  <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="{StaticResource BackgroundColor}" />
  <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="{StaticResource BackgroundColor}" />
  <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="{StaticResource BackgroundColor}" />
  <SolidColorBrush x:Key="TextControlBorderBrush" Color="{StaticResource DividerColor}" />
  <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="{StaticResource BorderColor}" />
  <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="{StaticResource AccentColor}" />
  <SolidColorBrush x:Key="TextControlBorderBrushDisabled" Color="{StaticResource DividerColor}" />
  <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="{StaticResource SubtleColor}" />
  <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver" Color="{StaticResource SubtleColor}" />
  <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused" Color="{StaticResource SubtleColor}" />
  <SolidColorBrush x:Key="TextControlPlaceholderForegroundDisabled" Color="{StaticResource SubtleColor}" />


  <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillChecked" Color="{StaticResource AccentColor}" />
  <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPointerOver" Color="{StaticResource AccentHoverColor}" />
  <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPressed" Color="{StaticResource AccentPressedColor}" />
  <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeChecked" Color="{StaticResource AccentColor}" />
  <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeCheckedPointerOver" Color="{StaticResource AccentHoverColor}" />
  <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeCheckedPressed" Color="{StaticResource AccentPressedColor}" />
  <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundChecked" Color="{StaticResource OnAccentColor}" />
  <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundCheckedPointerOver" Color="{StaticResource OnAccentColor}" />
  <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundCheckedPressed" Color="{StaticResource OnAccentColor}" />
  <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillIndeterminate" Color="{StaticResource AccentColor}" />
  <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeIndeterminate" Color="{StaticResource AccentColor}" />
  <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeUnchecked" Color="{StaticResource BorderColor}" />
  <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeUncheckedPointerOver" Color="{StaticResource FaintColor}" />
  <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedStroke" Color="{StaticResource AccentColor}" />
  <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedStrokePointerOver" Color="{StaticResource AccentHoverColor}" />
  <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedStrokePressed" Color="{StaticResource AccentPressedColor}" />
  <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedFill" Color="{StaticResource AccentColor}" />
  <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedFillPointerOver" Color="{StaticResource AccentHoverColor}" />
  <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedFillPressed" Color="{StaticResource AccentPressedColor}" />
  <SolidColorBrush x:Key="RadioButtonCheckGlyphFill" Color="{StaticResource OnAccentColor}" />
  <SolidColorBrush x:Key="RadioButtonCheckGlyphFillPointerOver" Color="{StaticResource OnAccentColor}" />
  <SolidColorBrush x:Key="RadioButtonCheckGlyphFillPressed" Color="{StaticResource OnAccentColor}" />
  <SolidColorBrush x:Key="RadioButtonOuterEllipseStroke" Color="{StaticResource BorderColor}" />

  <SolidColorBrush x:Key="ComboBoxForeground" Color="{StaticResource TextColor}" />
  <SolidColorBrush x:Key="ComboBoxForegroundFocused" Color="{StaticResource TextColor}" />
  <SolidColorBrush x:Key="ComboBoxForegroundFocusedPressed" Color="{StaticResource TextColor}" />
  <SolidColorBrush x:Key="ComboBoxForegroundDisabled" Color="{StaticResource TextColor}" />
  <SolidColorBrush x:Key="ComboBoxBackground" Color="{StaticResource BackgroundColor}" />
  <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="{StaticResource BackgroundColor}" />
  <SolidColorBrush x:Key="ComboBoxBackgroundPressed" Color="{StaticResource BackgroundColor}" />
  <SolidColorBrush x:Key="ComboBoxBackgroundUnfocused" Color="{StaticResource BackgroundColor}" />
  <SolidColorBrush x:Key="ComboBoxBackgroundDisabled" Color="{StaticResource BackgroundColor}" />
  <SolidColorBrush x:Key="ComboBoxBackgroundBorderBrushFocused" Color="{StaticResource AccentColor}" />
  <SolidColorBrush x:Key="ComboBoxBackgroundBorderBrushUnfocused" Color="{StaticResource DividerColor}" />
  <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="{StaticResource DividerColor}" />
  <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver" Color="{StaticResource BorderColor}" />
  <SolidColorBrush x:Key="ComboBoxBorderBrushPressed" Color="{StaticResource BorderColor}" />
  <SolidColorBrush x:Key="ComboBoxBorderBrushDisabled" Color="{StaticResource DividerColor}" />
  <SolidColorBrush x:Key="ComboBoxDropDownGlyphForeground" Color="{StaticResource SubtleColor}" />
  <SolidColorBrush x:Key="ComboBoxDropDownGlyphForegroundFocused" Color="{StaticResource TextColor}" />
  <SolidColorBrush x:Key="ComboBoxDropDownGlyphForegroundFocusedPressed" Color="{StaticResource TextColor}" />
  <SolidColorBrush x:Key="ComboBoxDropDownGlyphForegroundDisabled" Color="{StaticResource SubtleColor}" />
  <SolidColorBrush x:Key="ComboBoxPlaceHolderForeground" Color="{StaticResource SubtleColor}" />
  <SolidColorBrush x:Key="ComboBoxPlaceHolderForegroundFocusedPressed" Color="{StaticResource SubtleColor}" />
  <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="{StaticResource RaisedColor}" />
  <SolidColorBrush x:Key="ComboBoxDropDownBorderBrush" Color="{StaticResource DividerColor}" />
  <SolidColorBrush x:Key="ComboBoxItemBackgroundPointerOver" Color="{StaticResource SurfaceColor}" />
  <SolidColorBrush x:Key="ComboBoxItemBackgroundPressed" Color="{StaticResource DividerColor}" />
  <SolidColorBrush x:Key="ComboBoxItemBackgroundSelected" Color="{StaticResource SelectedColor}" />
  <SolidColorBrush x:Key="ComboBoxItemBackgroundSelectedPointerOver" Color="{StaticResource SelectedColor}" />
  <SolidColorBrush x:Key="ComboBoxItemBackgroundSelectedPressed" Color="{StaticResource SelectedColor}" />
  <SolidColorBrush x:Key="ComboBoxItemForegroundSelected" Color="{StaticResource TextColor}" />
  <SolidColorBrush x:Key="ComboBoxItemForegroundSelectedPointerOver" Color="{StaticResource TextColor}" />
  <SolidColorBrush x:Key="ComboBoxItemForegroundPointerOver" Color="{StaticResource TextColor}" />
</ResourceDictionary>
