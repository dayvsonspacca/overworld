<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ResourceDictionary.MergedDictionaries>
    <ColorPaletteResources Accent="{StaticResource AccentColor}"
                           AltHigh="{StaticResource BackgroundColor}"
                           AltLow="{StaticResource BackgroundColor}"
                           AltMedium="{StaticResource BackgroundColor}"
                           AltMediumHigh="{StaticResource BackgroundColor}"
                           AltMediumLow="{StaticResource BackgroundColor}"
                           BaseHigh="{StaticResource TextColor}"
                           BaseLow="{StaticResource DividerColor}"
                           BaseMedium="{StaticResource SubtleColor}"
                           BaseMediumHigh="{StaticResource TextSoftColor}"
                           BaseMediumLow="{StaticResource FaintColor}"
                           ChromeAltLow="{StaticResource TextSoftColor}"
                           ChromeBlackHigh="#000000"
                           ChromeBlackLow="{StaticResource TextSoftColor}"
                           ChromeBlackMedium="{StaticResource BackgroundColor}"
                           ChromeBlackMediumLow="{StaticResource BackgroundColor}"
                           ChromeDisabledHigh="{StaticResource DividerColor}"
                           ChromeDisabledLow="{StaticResource SubtleColor}"
                           ChromeGray="{StaticResource FaintColor}"
                           ChromeHigh="{StaticResource FaintColor}"
                           ChromeLow="{StaticResource RaisedColor}"
                           ChromeMedium="{StaticResource SurfaceColor}"
                           ChromeMediumLow="{StaticResource RaisedColor}"
                           ChromeWhite="{StaticResource TextColor}"
                           ListLow="{StaticResource RaisedColor}"
                           ListMedium="{StaticResource DividerColor}"
                           RegionColor="{StaticResource BackgroundColor}" />
  </ResourceDictionary.MergedDictionaries>

  <SolidColorBrush x:Key="TextSelectionBrush" Color="{DynamicResource AccentColor}" Opacity="0.35" />

  <SolidColorBrush x:Key="MenuFlyoutPresenterBackground" Color="{DynamicResource RaisedColor}" />
  <SolidColorBrush x:Key="MenuFlyoutPresenterBorderBrush" Color="{DynamicResource DividerColor}" />
  <SolidColorBrush x:Key="MenuFlyoutItemBackgroundPointerOver" Color="{DynamicResource DividerColor}" />
  <SolidColorBrush x:Key="MenuFlyoutItemBackgroundPressed" Color="{DynamicResource DividerColor}" />
  <SolidColorBrush x:Key="MenuFlyoutItemForegroundPointerOver" Color="{DynamicResource TextColor}" />
  <SolidColorBrush x:Key="MenuFlyoutItemForegroundPressed" Color="{DynamicResource TextColor}" />
  <SolidColorBrush x:Key="MenuFlyoutSeparatorBackground" Color="{DynamicResource DividerColor}" />
  <SolidColorBrush x:Key="TextControlForeground" Color="{DynamicResource TextColor}" />
  <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="{DynamicResource TextColor}" />
  <SolidColorBrush x:Key="TextControlForegroundFocused" Color="{DynamicResource TextColor}" />
  <SolidColorBrush x:Key="TextControlForegroundDisabled" Color="{DynamicResource TextColor}" />
  <SolidColorBrush x:Key="TextControlBackground" Color="{DynamicResource BackgroundColor}" />
  <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="{DynamicResource BackgroundColor}" />
  <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="{DynamicResource BackgroundColor}" />
  <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="{DynamicResource BackgroundColor}" />
  <SolidColorBrush x:Key="TextControlBorderBrush" Color="{DynamicResource DividerColor}" />
  <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="{DynamicResource BorderColor}" />
  <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="{DynamicResource AccentColor}" />
  <SolidColorBrush x:Key="TextControlBorderBrushDisabled" Color="{DynamicResource DividerColor}" />
  <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="{DynamicResource SubtleColor}" />
  <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver" Color="{DynamicResource SubtleColor}" />
  <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused" Color="{DynamicResource SubtleColor}" />
  <SolidColorBrush x:Key="TextControlPlaceholderForegroundDisabled" Color="{DynamicResource SubtleColor}" />


  <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillChecked" Color="{DynamicResource AccentColor}" />
  <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPointerOver" Color="{DynamicResource AccentHoverColor}" />
  <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPressed" Color="{DynamicResource AccentPressedColor}" />
  <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeChecked" Color="{DynamicResource AccentColor}" />
  <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeCheckedPointerOver" Color="{DynamicResource AccentHoverColor}" />
  <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeCheckedPressed" Color="{DynamicResource AccentPressedColor}" />
  <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundChecked" Color="{DynamicResource OnAccentColor}" />
  <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundCheckedPointerOver" Color="{DynamicResource OnAccentColor}" />
  <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundCheckedPressed" Color="{DynamicResource OnAccentColor}" />
  <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillIndeterminate" Color="{DynamicResource AccentColor}" />
  <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeIndeterminate" Color="{DynamicResource AccentColor}" />
  <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeUnchecked" Color="{DynamicResource BorderColor}" />
  <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeUncheckedPointerOver" Color="{DynamicResource FaintColor}" />
  <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedStroke" Color="{DynamicResource AccentColor}" />
  <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedStrokePointerOver" Color="{DynamicResource AccentHoverColor}" />
  <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedStrokePressed" Color="{DynamicResource AccentPressedColor}" />
  <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedFill" Color="{DynamicResource AccentColor}" />
  <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedFillPointerOver" Color="{DynamicResource AccentHoverColor}" />
  <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedFillPressed" Color="{DynamicResource AccentPressedColor}" />
  <SolidColorBrush x:Key="RadioButtonCheckGlyphFill" Color="{DynamicResource OnAccentColor}" />
  <SolidColorBrush x:Key="RadioButtonCheckGlyphFillPointerOver" Color="{DynamicResource OnAccentColor}" />
  <SolidColorBrush x:Key="RadioButtonCheckGlyphFillPressed" Color="{DynamicResource OnAccentColor}" />
  <SolidColorBrush x:Key="RadioButtonOuterEllipseStroke" Color="{DynamicResource BorderColor}" />

  <SolidColorBrush x:Key="ComboBoxForeground" Color="{DynamicResource TextColor}" />
  <SolidColorBrush x:Key="ComboBoxForegroundFocused" Color="{DynamicResource TextColor}" />
  <SolidColorBrush x:Key="ComboBoxForegroundFocusedPressed" Color="{DynamicResource TextColor}" />
  <SolidColorBrush x:Key="ComboBoxForegroundDisabled" Color="{DynamicResource TextColor}" />
  <SolidColorBrush x:Key="ComboBoxBackground" Color="{DynamicResource BackgroundColor}" />
  <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="{DynamicResource BackgroundColor}" />
  <SolidColorBrush x:Key="ComboBoxBackgroundPressed" Color="{DynamicResource BackgroundColor}" />
  <SolidColorBrush x:Key="ComboBoxBackgroundUnfocused" Color="{DynamicResource BackgroundColor}" />
  <SolidColorBrush x:Key="ComboBoxBackgroundDisabled" Color="{DynamicResource BackgroundColor}" />
  <SolidColorBrush x:Key="ComboBoxBackgroundBorderBrushFocused" Color="{DynamicResource AccentColor}" />
  <SolidColorBrush x:Key="ComboBoxBackgroundBorderBrushUnfocused" Color="{DynamicResource DividerColor}" />
  <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="{DynamicResource DividerColor}" />
  <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver" Color="{DynamicResource BorderColor}" />
  <SolidColorBrush x:Key="ComboBoxBorderBrushPressed" Color="{DynamicResource BorderColor}" />
  <SolidColorBrush x:Key="ComboBoxBorderBrushDisabled" Color="{DynamicResource DividerColor}" />
  <SolidColorBrush x:Key="ComboBoxDropDownGlyphForeground" Color="{DynamicResource SubtleColor}" />
  <SolidColorBrush x:Key="ComboBoxDropDownGlyphForegroundFocused" Color="{DynamicResource TextColor}" />
  <SolidColorBrush x:Key="ComboBoxDropDownGlyphForegroundFocusedPressed" Color="{DynamicResource TextColor}" />
  <SolidColorBrush x:Key="ComboBoxDropDownGlyphForegroundDisabled" Color="{DynamicResource SubtleColor}" />
  <SolidColorBrush x:Key="ComboBoxPlaceHolderForeground" Color="{DynamicResource SubtleColor}" />
  <SolidColorBrush x:Key="ComboBoxPlaceHolderForegroundFocusedPressed" Color="{DynamicResource SubtleColor}" />
  <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="{DynamicResource RaisedColor}" />
  <SolidColorBrush x:Key="ComboBoxDropDownBorderBrush" Color="{DynamicResource DividerColor}" />
  <SolidColorBrush x:Key="ComboBoxItemBackgroundPointerOver" Color="{DynamicResource SurfaceColor}" />
  <SolidColorBrush x:Key="ComboBoxItemBackgroundPressed" Color="{DynamicResource DividerColor}" />
  <SolidColorBrush x:Key="ComboBoxItemBackgroundSelected" Color="{DynamicResource SelectedColor}" />
  <SolidColorBrush x:Key="ComboBoxItemBackgroundSelectedPointerOver" Color="{DynamicResource SelectedColor}" />
  <SolidColorBrush x:Key="ComboBoxItemBackgroundSelectedPressed" Color="{DynamicResource SelectedColor}" />
  <SolidColorBrush x:Key="ComboBoxItemForegroundSelected" Color="{DynamicResource TextColor}" />
  <SolidColorBrush x:Key="ComboBoxItemForegroundSelectedPointerOver" Color="{DynamicResource TextColor}" />
  <SolidColorBrush x:Key="ComboBoxItemForegroundPointerOver" Color="{DynamicResource TextColor}" />
</ResourceDictionary>
