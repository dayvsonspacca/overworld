<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:desktop="using:Overworld.Desktop">
  <!-- The column on the left of a window: sections stacked on the surface colour, a line between them. -->
  <ControlTheme x:Key="{x:Type desktop:Sidebar}" TargetType="desktop:Sidebar">
    <Setter Property="Width" Value="260" />
    <Setter Property="Background" Value="{DynamicResource RaisedBrush}" />
    <Setter Property="Line" Value="{DynamicResource DividerBrush}" />
  </ControlTheme>
</ResourceDictionary>
