<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:framing="using:Overworld.Desktop.Framing">
  <!-- Another app's thing inside this one: a header naming the app that lends it, its title and an expand button (none without a command), the thing on a stage of fixed height; out of sight, the stage is only its surface. -->
  <ControlTheme x:Key="{x:Type framing:ItemFrame}" TargetType="framing:ItemFrame">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="MaxWidth" Value="720" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border ClipToBounds="True"
                CornerRadius="{StaticResource RadiusContainer}"
                BorderThickness="1"
                BorderBrush="{DynamicResource DividerBrush}"
                Background="{DynamicResource RaisedBrush}">
          <DockPanel>
            <Border DockPanel.Dock="Top"
                    Height="{StaticResource BarHeight}"
                    Padding="12,0,4,0"
                    BorderBrush="{DynamicResource DividerBrush}"
                    BorderThickness="0,0,0,1">
              <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                <Border Name="PART_Source"
                        IsVisible="{TemplateBinding Source, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                        Padding="8,1"
                        VerticalAlignment="Center"
                        CornerRadius="{StaticResource RadiusPill}"
                        Background="{DynamicResource SelectedBrush}">
                  <TextBlock Text="{TemplateBinding Source}"
                             FontSize="{StaticResource FontSizeFootnote}"
                             Foreground="{DynamicResource AccentTextBrush}" />
                </Border>
                <TextBlock Grid.Column="1"
                           Text="{TemplateBinding Title}"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
                <Button Name="PART_Expand"
                        Grid.Column="2"
                        Classes="icon"
                        IsVisible="{TemplateBinding ExpandCommand, Converter={x:Static ObjectConverters.IsNotNull}}"
                        Command="{TemplateBinding ExpandCommand}"
                        CommandParameter="{TemplateBinding ExpandCommandParameter}"
                        ToolTip.Tip="Expand">
                  <Path Data="M9,1 L15,1 L15,7 M15,1 L9,7 M7,15 L1,15 L1,9 M1,15 L7,9" />
                </Button>
              </Grid>
            </Border>
            <Border Name="PART_Surface" Height="{TemplateBinding StageHeight}" Background="{DynamicResource SurfaceBrush}">
              <ContentPresenter Name="PART_Stage" ContentTemplate="{TemplateBinding ItemTemplate}" />
            </Border>
          </DockPanel>
        </Border>
      </ControlTemplate>
    </Setter>
  </ControlTheme>
</ResourceDictionary>
