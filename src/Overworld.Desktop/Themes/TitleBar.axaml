<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:windowing="using:Overworld.Desktop.Windowing">
  <!-- A window control at the right of the bar: as tall as the bar, a thin glyph, closing turns red. -->
  <ControlTheme x:Key="TitleBarControl" TargetType="Button">
    <Setter Property="Width" Value="46" />
    <Setter Property="Height" Value="{StaticResource BarHeight}" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource SubtleBrush}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}">
          <ContentPresenter Content="{TemplateBinding Content}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />
        </Border>
      </ControlTemplate>
    </Setter>

    <Style Selector="^:pointerover">
      <Setter Property="Background" Value="{DynamicResource HoverTintBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    </Style>
    <Style Selector="^:pressed">
      <Setter Property="Background" Value="{DynamicResource ActiveTintBrush}" />
    </Style>
    <Style Selector="^.close:pointerover, ^.close:pressed">
      <Setter Property="Background" Value="{DynamicResource DangerBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource BackgroundBrush}" />
    </Style>
  </ControlTheme>

  <!-- The bar on top of every app window: the app's icon, its title in the middle, the window controls. -->
  <ControlTheme x:Key="{x:Type windowing:TitleBar}" TargetType="windowing:TitleBar">
    <Setter Property="Height" Value="{StaticResource BarHeight}" />
    <Setter Property="Background" Value="{DynamicResource RaisedBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}">
          <Grid ColumnDefinitions="*,Auto,*">
            <Image Source="{TemplateBinding Icon}"
                   IsVisible="{TemplateBinding Icon, Converter={x:Static ObjectConverters.IsNotNull}}"
                   Width="16"
                   Height="16"
                   Margin="12,0,0,0"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Center"
                   RenderOptions.BitmapInterpolationMode="None" />

            <TextBlock Grid.Column="1"
                       Text="{TemplateBinding Title}"
                       FontSize="{StaticResource FontSizeBody}"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextBrush}"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"
                       IsHitTestVisible="False" />

            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
              <Button Name="PART_Minimize"
                      Theme="{StaticResource TitleBarControl}"
                      AutomationProperties.Name="Minimize">
                <Path Data="M3.5,8.5 L12.5,8.5" Width="16" Height="16" StrokeThickness="1" Stroke="{Binding $parent[Button].Foreground}" />
              </Button>
              <Button Name="PART_Maximize"
                      Theme="{StaticResource TitleBarControl}"
                      AutomationProperties.Name="Maximize">
                <Panel>
                  <Path Name="PART_MaximizeIcon" Data="M3.5,3.5 H12.5 V12.5 H3.5 Z" Width="16" Height="16" StrokeThickness="1" Stroke="{Binding $parent[Button].Foreground}" />
                  <Path Name="PART_RestoreIcon" Data="M3.5,5.5 H10.5 V12.5 H3.5 Z M5.5,5.5 V3.5 H12.5 V10.5 H10.5" Width="16" Height="16" StrokeThickness="1" Stroke="{Binding $parent[Button].Foreground}" IsVisible="False" />
                </Panel>
              </Button>
              <Button Name="PART_Close"
                      Classes="close"
                      Theme="{StaticResource TitleBarControl}"
                      AutomationProperties.Name="Close">
                <Path Data="M4,4 L12,12 M12,4 L4,12" Width="16" Height="16" StrokeThickness="1" Stroke="{Binding $parent[Button].Foreground}" />
              </Button>
            </StackPanel>
          </Grid>
        </Border>
      </ControlTemplate>
    </Setter>

    <Style Selector="^:tiles /template/ Button#PART_Minimize, ^:tiles /template/ Button#PART_Maximize">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="^:maximized /template/ Path#PART_MaximizeIcon">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="^:maximized /template/ Path#PART_RestoreIcon">
      <Setter Property="IsVisible" Value="True" />
    </Style>
  </ControlTheme>
</ResourceDictionary>
