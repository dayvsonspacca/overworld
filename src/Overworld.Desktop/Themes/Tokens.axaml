<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Spacing on a 4 px grid. -->
  <x:Double x:Key="Space1">4</x:Double>
  <x:Double x:Key="Space2">8</x:Double>
  <x:Double x:Key="Space3">12</x:Double>
  <x:Double x:Key="Space4">16</x:Double>
  <x:Double x:Key="Space6">24</x:Double>
  <x:Double x:Key="Space8">32</x:Double>

  <Thickness x:Key="PadControl">8,6</Thickness>
  <Thickness x:Key="PadRow">16,12</Thickness>
  <Thickness x:Key="PadPane">16</Thickness>

  <!-- Type scale after the macOS text styles: body 13, never under 10. -->
  <x:Double x:Key="FontSizeFootnote">11</x:Double>
  <x:Double x:Key="FontSizeCallout">12</x:Double>
  <x:Double x:Key="FontSizeBody">13</x:Double>
  <x:Double x:Key="FontSizeContent">14</x:Double>
  <x:Double x:Key="FontSizeTitle3">15</x:Double>
  <x:Double x:Key="FontSizeTitle1">22</x:Double>
  <x:Double x:Key="FontSizeLargeTitle">26</x:Double>

  <!-- Mono is for data people read as code: paths, shortcuts, tool names, times. -->
  <FontFamily x:Key="MonoFont">JetBrainsMono Nerd Font, JetBrains Mono, monospace</FontFamily>

  <CornerRadius x:Key="RadiusSmall">4</CornerRadius>
  <CornerRadius x:Key="RadiusControl">6</CornerRadius>
  <CornerRadius x:Key="RadiusContainer">10</CornerRadius>
  <CornerRadius x:Key="RadiusWindow">14</CornerRadius>
  <CornerRadius x:Key="RadiusPill">99</CornerRadius>

  <x:Double x:Key="ControlSmall">24</x:Double>
  <x:Double x:Key="Control">28</x:Double>
  <x:Double x:Key="ControlLarge">32</x:Double>
  <x:Double x:Key="BarHeight">36</x:Double>
  <x:Double x:Key="HeaderHeight">40</x:Double>
</ResourceDictionary>
