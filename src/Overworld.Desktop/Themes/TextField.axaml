<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:desktop="using:Overworld.Desktop">
  <!-- A label, a box to type in, and one line under it: the hint, or the error that refused the value. -->
  <ControlTheme x:Key="{x:Type desktop:TextField}" TargetType="desktop:TextField">
    <Setter Property="Template">
      <ControlTemplate>
        <StackPanel Spacing="6">
          <TextBlock Name="PART_Label"
                     Text="{TemplateBinding Label}"
                     IsVisible="{TemplateBinding Label, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                     FontSize="{StaticResource FontSizeCallout}"
                     FontWeight="SemiBold" />
          <TextBox Name="PART_Input"
                   Classes.invalid="{TemplateBinding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                   Text="{Binding Text, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                   PlaceholderText="{TemplateBinding Placeholder}"
                   IsEnabled="{TemplateBinding IsEnabled}" />
          <TextBlock Name="PART_Hint"
                     Text="{TemplateBinding Hint}"
                     IsVisible="{TemplateBinding Hint, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                     FontSize="{StaticResource FontSizeFootnote}"
                     TextWrapping="Wrap"
                     Foreground="{DynamicResource SubtleBrush}" />
          <TextBlock Name="PART_Error"
                     Text="{TemplateBinding Error}"
                     IsVisible="False"
                     FontSize="{StaticResource FontSizeFootnote}"
                     TextWrapping="Wrap"
                     Foreground="{DynamicResource DangerBrush}" />
        </StackPanel>
      </ControlTemplate>
    </Setter>

    <Style Selector="^:invalid /template/ TextBlock#PART_Hint">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="^:invalid /template/ TextBlock#PART_Error">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="^:disabled /template/ TextBlock">
      <Setter Property="Opacity" Value="0.5" />
    </Style>
  </ControlTheme>
</ResourceDictionary>
