<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:desktop="using:Overworld.Bedrock.Desktop"
             x:Class="Overworld.Bedrock.Desktop.BedrockApplication"
             RequestedThemeVariant="{x:Static desktop:BedrockApplication.Amethyst}">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceInclude x:Key="{x:Static desktop:BedrockApplication.Amethyst}" Source="/Themes/Amethyst.axaml" />
      </ResourceDictionary.ThemeDictionaries>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="/Themes/Tokens.axaml" />
        <ResourceInclude Source="/Themes/TextField.axaml" />
        <ResourceInclude Source="/Themes/SidebarSection.axaml" />
        <ResourceInclude Source="/Themes/Sidebar.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="/Themes/Controls.axaml" />
  </Application.Styles>
</Application>
