<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style Selector="Window">
    <Setter Property="Background" Value="{DynamicResource BackgroundBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
    <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
  </Style>

  <!-- Data people read as code: paths, shortcuts, tool names, times. -->
  <Style Selector="TextBlock.mono">
    <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
    <Setter Property="FontSize" Value="{StaticResource FontSizeFootnote}" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{DynamicResource ForegroundMutedBrush}" />
  </Style>

  <!-- The title of a group of rows: sentence case, never tracked capitals. -->
  <Style Selector="TextBlock.group">
    <Setter Property="FontSize" Value="{StaticResource FontSizeFootnote}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{DynamicResource ForegroundMutedBrush}" />
  </Style>

  <!-- Lists select in the theme's colours, not Fluent's blue. -->
  <Style Selector="ListBoxItem">
    <Setter Property="Padding" Value="10,7" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusSmall}" />
    <Setter Property="MinHeight" Value="0" />
  </Style>
  <Style Selector="ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
  </Style>
  <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter, ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SelectedBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
  </Style>

  <!-- Anything you click shows a hand; anything you can select shows a text cursor. -->
  <Style Selector="Button, ToggleButton, CheckBox, ComboBox, ComboBoxItem, ListBoxItem, MenuItem">
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button:disabled, ToggleButton:disabled, CheckBox:disabled, ComboBox:disabled, ComboBoxItem:disabled, ListBoxItem:disabled, MenuItem:disabled">
    <Setter Property="Cursor" Value="Arrow" />
  </Style>
  <Style Selector="SelectableTextBlock">
    <Setter Property="Cursor" Value="IBeam" />
    <Setter Property="SelectionBrush" Value="{DynamicResource TextSelectionBrush}" />
  </Style>
</Styles>
